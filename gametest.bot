# gametest.bot -- the windowed game, exercised with no display.
#
# Raven's headless mode runs the same windows, the same layout and the same
# events as a desktop does, with synthetic input instead of a mouse. This
# program builds the game's window, lays it out, and drives it the way a
# player does.
#
# It checks three things:
#
#   1. a tile of the map is reachable from every corner of it -- the pointer's
#      position must be read as the position it was given, not as one
#      coordinate of it;
#   2. choosing a tool and clicking the map builds, and the treasury moves;
#   3. choosing the inspect tool and clicking a developed tile says what is
#      there.
#
# The driving is Raven 0.4.0's own synthetic input (`inject_move`,
# `inject_button`, `inject_key_down`) and the game's own event step
# (`simcity::app::take_events`), which is what the game's loop calls after a
# frame: a test drives exactly the code the game runs.
import raven
import std::float64
import std::int
import std::list
import std::str
import raven::widget
import raven::window
import simcity::app
import simcity::city
import simcity::scenario
import simcity::screen
import simcity::sim
import simcity::store

with context raven::create()
with context simcity::screen::create()
with context simcity::store::create()

nomethod fn dash() -> str:
    "".append_char('-')

nomethod fn whole(value: Float64) -> int:
    if value < 0.0:
        0
    else:
        std::float64::truncate(value)

# Draws TIMES frames and answers how many were drawn: a fold over one count,
# so the function has one exit rather than two that both answer zero.
nomethod fn frames(times: int) -> int:
    fold i from 0 to times with intermediate drawn 0:
        more = raven::draw_frame()
        if more:
            drawn + 1
        else:
            drawn

# Where the widget was laid out by the last frame.
nomethod fn at(widget: raven::Widget) -> raven::Rect:
    raven::rect(widget)

# Every road tile in the city.
nomethod fn road_count(city: simcity::city::City) -> int:
    fold row from 0 to city.height with intermediate made 0:
        fold col from 0 to city.width with intermediate u made:
            u + simcity::city::road_at(city, col, row)

# Aims at the window point (PX, PY), lets the frames deliver it, and answers
# the tile the pointer lands on: the row and column the game would build on.
nomethod fn point(game: simcity::app::Game, laid: raven::Rect, px: int, py: int) -> simcity::app::Place errors NonFiniteFloat:
    aim = game.window.inject_move(laid.x + std::float64::from_int(px), laid.y + std::float64::from_int(py)):
        on NonFiniteFloat:
            unit
    moved = frames(4)
    simcity::app::where_is_the_cursor(game)

nomethod fn inside_code(row: int, col: int) -> int:
    if row >= 0 and col >= 0 and row < simcity::app::DOWN and col < simcity::app::ACROSS:
        1
    else:
        0

# The tile's code: 1 on the map's viewport, 0 outside it.
nomethod fn code_of(place: simcity::app::Place) -> int:
    inside_code(place.y, place.x)

# The left button goes down at where the pointer is, a frame delivers the press,
# and the game answers it: this is what a click is, from here on.
nomethod fn click(game: simcity::app::Game) -> simcity::app::Game:
    pressed = game.window.inject_button(raven::window::R_MOUSE_LEFT, true)
    delivered = frames(4)
    simcity::app::take_events(game)

fn main() -> List[str] errors raven::RavenFailed, NonFiniteFloat:
    raven::start(raven::headless())
    # A city with something on it already, so the inspector has something to
    # say and the click has something to change.
    town = simcity::scenario::town(7)
    game = simcity::app::build(town)
    laid = frames(6)
    shown = simcity::app::show(game)
    more = frames(6)
    where = at(game.map)
    wide = whole(where.width)
    tall = whole(where.height)
    top_left = point(game, where, 8, 8)
    top_right = point(game, where, wide - 8, 8)
    bottom_left = point(game, where, 8, tall - 8)
    bottom_right = point(game, where, wide - 8, tall - 8)
    corners = code_of(top_left) * 1000 + code_of(top_right) * 100 + code_of(bottom_left) * 10 + code_of(bottom_right)
    # Build a road by clicking.
    picked = simcity::app::with_tool(shown, simcity::city::Tool::Road)
    chosen = simcity::app::show(picked)
    chosen_frames = frames(6)
    clicked = click(chosen)
    delivered = frames(4)
    built = simcity::app::state(clicked).city
    spent = 20000 - simcity::city::funds(built)
    # Holding the button must not keep paying. A press is one event, so a button
    # held over one tile is one MousePressed however long it is held, and the
    # frames after it deliver nothing further: aim at a bare tile, press, and
    # answer the events three times -- the press costs a road and the two that
    # follow it cost nothing, because there is nothing left to answer.
    aim = game.window.inject_move(where.x + std::float64::from_int(2 * simcity::app::TILE_PX + 8), where.y + std::float64::from_int(2 * simcity::app::TILE_PX + 8)):
        on NonFiniteFloat:
            unit
    holding = frames(4)
    once = click(clicked)
    after_one = simcity::city::funds(simcity::app::state(once).city)
    twice = simcity::app::take_events(once)
    after_two = simcity::city::funds(simcity::app::state(twice).city)
    thrice = simcity::app::take_events(twice)
    after_three = simcity::city::funds(simcity::app::state(thrice).city)
    held_cost = after_one - after_two
    still_cost = after_two - after_three
    # One placement happened -- the tile the pointer moved onto has a road on
    # it -- and the two further answers with the button still down cost nothing.
    held_roads = simcity::city::road_at(simcity::app::state(thrice).city, 2, 2)
    held_once = if held_roads == 1 and held_cost == 0 and still_cost == 0:
        1
    else:
        0
    roads = road_count(built)
    # Now inspect the town's own residential block.
    looked = simcity::app::with_tool(clicked, simcity::city::Tool::Inspect)
    looking = simcity::app::show(looked)
    look_frames = frames(6)
    aimed = game.window.inject_move(where.x + std::float64::from_int(12 * simcity::app::TILE_PX + 8), where.y + std::float64::from_int(8 * simcity::app::TILE_PX + 8)):
        on NonFiniteFloat:
            unit
    aimed_frames = frames(4)
    read_tile = click(looking)
    told = frames(4)
    note = simcity::app::state(read_tile).message
    # Saving and loading, through the game's own buttons: the city is written to
    # the path the field names and read back from it, and the road the click
    # built is still there afterwards. This is the check that the whole chain
    # works -- the buttons, the field, the raw layer and the format -- and not
    # only the format on its own.
    kept = simcity::app::act(clicked, "save")
    saved = simcity::app::show(kept)
    saved_frames = frames(4)
    said = simcity::app::state(saved).message
    # A different city, loaded over it: the road the save held comes back.
    other_town = simcity::scenario::town(11)
    other = simcity::app::with_city(saved, other_town)
    reloaded = simcity::app::act(other, "load")
    loaded = simcity::app::show(reloaded)
    loaded_frames = frames(4)
    told_load = simcity::app::state(loaded).message
    # The city that came back is the city that was saved: the same roads, the
    # same money, and the same month -- not a fresh town on the same land.
    put_away = simcity::app::state(saved).city
    came_back = simcity::app::state(loaded).city
    before_funds = simcity::city::funds(put_away)
    after_funds = simcity::city::funds(came_back)
    before_roads = road_count(put_away)
    after_roads = road_count(came_back)
    same_money = if after_funds == before_funds:
        1
    else:
        0
    same_roads = if after_roads == before_roads:
        1
    else:
        0
    same_month = if simcity::city::month(came_back) == simcity::city::month(put_away):
        1
    else:
        0
    # The view moves: a key goes down, the game's own event step sees the press
    # once, and the view is one step further on. A key press is an event, so a
    # held key is one KeyPressed and Raven's auto-repeat arrives as KeyRepeated,
    # which the game deliberately does not act on: the view moves one step and
    # then waits, which is what the polled mask did. A map the size the game
    # starts on: the towns the scenarios build are 32 by 32, which a 32-tile
    # viewport exactly covers, so a scroll needs a bigger map than a
    # scenario's.
    wide_city = simcity::app::with_city(saved, simcity::city::make(simcity::app::MAP_WIDE, simcity::app::MAP_TALL, 7, 20000))
    before_x = simcity::app::state(wide_city).origin_x
    before_y = simcity::app::state(wide_city).origin_y
    held_key = game.window.inject_key_down(raven::window::R_KEY_RIGHT, 0)
    stepped = simcity::app::take_events(wide_city)
    after_x = simcity::app::state(stepped).origin_x
    after_y = simcity::app::state(stepped).origin_y
    # The key is still down and a frame has delivered nothing new: no step.
    held_frame = frames(4)
    still = simcity::app::take_events(stepped)
    still_x = simcity::app::state(still).origin_x
    let_go = game.window.inject_key_up(raven::window::R_KEY_RIGHT, 0)
    released = frames(4)
    went_up = simcity::app::take_events(still)
    let_go_x = simcity::app::state(went_up).origin_x
    sideways = if after_x == before_x + simcity::app::VIEW_STEP_ACROSS and after_y == before_y:
        1
    else:
        0
    moved = if after_x > before_x:
        1
    else:
        0
    stepped_once = if still_x == after_x and let_go_x == after_x:
        1
    else:
        0
    # The map must be an image widget: the texture is uploaded into one, and a
    # container in its place takes the upload silently and draws nothing.
    kind = raven::widget::Rwidget_get_type(game.map.id)
    drawn = if kind == raven::widget::R_WIDGET_IMAGE:
        1
    else:
        0
    # The palette must fit inside the window. A control laid out below the
    # window's bottom edge is never drawn and can never be clicked, so two
    # things are measured: where the palette's own bottom edge lands, and
    # whether its controls want more room than the row beside the map has.
    # The second is the one with teeth: the palette that made the lower half of
    # the palette unreachable wanted 486 points in a 304-point row, and this
    # figure answered 0 then.
    window_size = raven::size(game.window)
    tools = at(game.tools)
    tools_bottom = whole(tools.y) + whole(tools.height)
    fits = if tools_bottom <= window_size.height:
        1
    else:
        0
    wants = simcity::screen::wish(game.tools):
        on IndexNotFound:
            [0.0, 0.0]
        on NativeViewNull:
            [0.0, 0.0]
        on simcity::screen::OutOfRange:
            [0.0, 0.0]
    wanted = whole(wants.get(1, 0.0))
    room = whole(tools.height)
    room_enough = if wanted <= room:
        1
    else:
        0
    raven::stop()
    ["the map is ".concat(std::int::to_string(wide)).append_char(',').append_char(' ').concat(std::int::to_string(tall)), "corners reachable ".concat(std::int::to_string(corners)), "spent ", std::int::to_string(spent), "holding the button cost ".concat(std::int::to_string(held_once)).append_char(' ').concat(std::int::to_string(held_cost)).append_char('/').concat(std::int::to_string(still_cost)).append_char(' ').concat(std::int::to_string(held_roads)), "roads in the viewport ".concat(std::int::to_string(roads)), "the inspector says: ".concat(note), "the map is an image widget ".concat(std::int::to_string(drawn)), "the palette fits the window ".concat(std::int::to_string(fits)), "the palette has room ".concat(std::int::to_string(room_enough)).append_char(' ').concat(std::int::to_string(wanted)).append_char('/').concat(std::int::to_string(room)), "the save said: ".concat(said), "after loading, the road is back: ".concat(told_load), "the load gave back the same money ".concat(std::int::to_string(same_money)), "the same roads ".concat(std::int::to_string(same_roads)), "the same month ".concat(std::int::to_string(same_month)), "the arrow key moved the view ".concat(std::int::to_string(moved)), "by one step at a time ".concat(std::int::to_string(sideways)), "and moved it once ".concat(std::int::to_string(stepped_once)).append_char(' ').concat(std::int::to_string(before_x)).concat(dash()).concat(std::int::to_string(after_x)).concat(dash()).concat(std::int::to_string(still_x)).append_char(' ').concat(std::int::to_string(before_y)).concat(dash()).concat(std::int::to_string(after_y)), "a click scrolled the view to ".concat(std::int::to_string(simcity::app::state(loaded).origin_x)).append_char(',').append_char(' ').concat(std::int::to_string(simcity::app::state(loaded).origin_y))]

result = main():
    on raven::RavenFailed failure:
        ["Raven did not start", failure.detail]
    on NonFiniteFloat:
        ["a figure Raven reported is not a number"]
result
