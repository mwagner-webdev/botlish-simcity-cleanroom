# simcity::app -- the game's window, its controls, and the loop that runs both.
#
# This module is where the simulation meets Raven. It holds the city (a value
# the simulation owns), reads what the mouse does as construction, and copies
# the city's figures onto the controls. It contains no simulation rules of its
# own: every number it shows comes out of simcity::sim, and every change it
# makes goes in through simcity::actions.
#
# The loop is a recursion of a function over its own state, which the native
# backends run as a loop: one frame, its events, one month of city time when
# the clock says so, and the next frame. A timer ticks every tenth of a second
# and its events are what wake the loop, so the city advances whether the
# player is clicking or not.
#
# The game's mutable state is one struct held in a one-slot MutableArray,
# because Botlish structs have no field assignment: a change is a new struct
# and a write into the array. That is the price of immutable records here, paid
# once in `put` and the `State` literals rather than spread over the program.
#
# Input is Raven 0.4.0's: the window is watched (`watch_input`), so a key
# press, a mouse press, every pointer move and the wheel are events of
# `raven::events()`, and the question "is it held now?" is a query
# (`mouse_button_down?`, `mouse_position`). Raven 0.3.2 exposed widget events
# only, so the map was read by polling the window through generated C bindings
# and two native float cells of this game's own; that is gone. The two
# facilities answer two different questions and the map uses each for the one
# it answers: a press is an event, so a construction happens once however long
# the button is held, and a drag is the move events with the button held, so a
# line runs along the tiles the pointer actually crossed.
import std::abi::bytes
import std::ffi::c
import std::float64
import std::int
import std::mutable_array
import std::str
import type simcity::city::Tool
import raven
import raven::controls
import raven::widget
import raven::window
import simcity::actions
import simcity::city
import simcity::render
import simcity::save
import simcity::screen
import simcity::store
import simcity::sim
import simcity::toolbar
import simcity::words

# --- The shape of the game -------------------------------------------------

# Map tiles the viewport shows, and screen pixels per map tile. A viewport of
# 32 by 22 tiles is what fits beside a 500-point palette in a window that is
# still small enough for a laptop screen, and it is a quarter of the map, so
# there is a city to scroll through rather than a city that is all on screen.
ACROSS = 32
DOWN = 22
TILE_PX = 16
# The map a new town starts on: four times the area of the viewport, so the
# player has to choose where to build rather than building everywhere at once.
MAP_WIDE = 64
MAP_TALL = 64
# How far the view moves at one step of a scroll button: a screen less a couple
# of rows of overlap, so a scroll never hides the ground the player was looking
# at and the next view still shows where the last one ended.
VIEW_STEP_ACROSS = ACROSS - 2
VIEW_STEP_DOWN = DOWN - 2
# The palette's width in screen pixels.
TOOL_WIDE = 500
# The file a save starts as. A player types over it: the field is there so a
# city can be kept in more than one place.
SAVE_PATH = "simcity.save"

# The window, sized so the map and the palette fit beside each other inside it:
# a control laid out outside the window is neither drawn nor clickable, which
# is the bug the three-column palette was built to avoid.
WINDOW_WIDE = 1040
WINDOW_TALL = 620

# How fast the city runs: a choice of simulated month per timer tick. A tick
# of the timer is a tenth of a second, so "month" is a month every half a
# second and "rush" is ten a second.
enum Speed:
    Paused,
    Month,
    Rush

# The mutable part of the game: the city and where the player stands.
struct State:
    city: simcity::city::City
    tool: simcity::city::Tool
    speed: Speed
    origin_x: int
    origin_y: int
    cursor_x: int
    cursor_y: int
    drag_x: int
    drag_y: int
    ticks: int
    message: str
    redraw: bool

# Everything the game holds: its state, and the widgets that show it.
struct Game:
    state: MutableArray[State]
    window: raven::Window
    map: raven::Widget
    tools: raven::Widget
    funds: raven::Widget
    people: raven::Widget
    jobs: raven::Widget
    date: raven::Widget
    tempo: raven::Widget
    want_r: raven::Widget
    want_c: raven::Widget
    want_i: raven::Widget
    note: raven::Widget
    path: raven::Widget
    tax: raven::Widget
    clock: raven::Timer

# --- Small helpers ---------------------------------------------------------

nomethod fn whole(value: Float64) -> int:
    if value < 0.0:
        0
    else:
        std::float64::truncate(value)

nomethod fn speed_label(speed: Speed) -> str:
    if speed == Speed::Paused:
        "Tempo: paused"
    elif speed == Speed::Month:
        "Tempo: month"
    else:
        "Tempo: rush"

nomethod fn screen_width() -> Float64:
    std::float64::from_int(TILE_PX * ACROSS)

nomethod fn screen_height() -> Float64:
    std::float64::from_int(TILE_PX * DOWN)

# The map box alone, without the scroll row under it: the palette beside it is
# held to this, so the two columns of the body end at the same edge.
nomethod fn screen_tall() -> int:
    TILE_PX * DOWN

# The points a scroll row of buttons takes up, alongside the map: enough for
# one row of controls and no more, so the map stays the tall thing in its
# column.
VIEW_ROW = 34

# Simulated months per timer tick.
nomethod fn speed_rate(speed: Speed) -> int:
    if speed == Speed::Paused:
        0
    elif speed == Speed::Month:
        5
    else:
        1

nomethod fn rate_of(value: Float64) -> int:
    if value < 0.0:
        0
    elif value > 20.0:
        20
    else:
        std::float64::truncate(value)

# --- A state, and changing one part of it ----------------------------------

nomethod fn no_state() -> State:
    State {
        city: simcity::city::make(8, 8, 1, 0),
        tool: simcity::city::Tool::None,
        speed: Speed::Month,
        origin_x: 0,
        origin_y: 0,
        cursor_x: -1,
        cursor_y: -1,
        drag_x: -1,
        drag_y: -1,
        ticks: 0,
        message: "nothing here",
        redraw: false
    }

nomethod fn state(game: Game) -> State:
    if 0 < game.state.capacity():
        game.state.at(0)
    else:
        no_state()

# Writes S into the caller's own state, in place.
nomethod fn put(place game: Game, s: State) -> unit:
    if 0 < game.state.capacity():
        game.state.set(0, s)
    else:
        unit

nomethod fn with_city(game: Game, city: simcity::city::City) -> Game:
    s = state(game)
    put(game, State {
        city: city,
        tool: s.tool,
        speed: s.speed,
        origin_x: s.origin_x,
        origin_y: s.origin_y,
        cursor_x: s.cursor_x,
        cursor_y: s.cursor_y,
        drag_x: s.drag_x,
        drag_y: s.drag_y,
        ticks: s.ticks,
        message: s.message,
        redraw: true
    })
    game

nomethod fn with_message(game: Game, text: str) -> Game:
    s = state(game)
    put(game, State {
        city: s.city,
        tool: s.tool,
        speed: s.speed,
        origin_x: s.origin_x,
        origin_y: s.origin_y,
        cursor_x: s.cursor_x,
        cursor_y: s.cursor_y,
        drag_x: s.drag_x,
        drag_y: s.drag_y,
        ticks: s.ticks,
        message: text,
        redraw: true
    })
    game

nomethod fn with_tool(game: Game, tool: Tool) -> Game:
    s = state(game)
    put(game, State {
        city: s.city,
        tool: tool,
        speed: s.speed,
        origin_x: s.origin_x,
        origin_y: s.origin_y,
        cursor_x: s.cursor_x,
        cursor_y: s.cursor_y,
        drag_x: s.drag_x,
        drag_y: s.drag_y,
        ticks: s.ticks,
        message: simcity::words::show_tool(tool).concat(", ").concat(simcity::words::show_cost(tool)),
        redraw: true
    })
    game

nomethod fn with_speed(game: Game, speed: Speed) -> Game:
    s = state(game)
    put(game, State {
        city: s.city,
        tool: s.tool,
        speed: speed,
        origin_x: s.origin_x,
        origin_y: s.origin_y,
        cursor_x: s.cursor_x,
        cursor_y: s.cursor_y,
        drag_x: s.drag_x,
        drag_y: s.drag_y,
        ticks: s.ticks,
        message: speed_label(speed),
        redraw: true
    })
    game

nomethod fn with_view(game: Game, origin_x: int, origin_y: int) -> Game:
    s = state(game)
    put(game, State {
        city: s.city,
        tool: s.tool,
        speed: s.speed,
        origin_x: origin_x,
        origin_y: origin_y,
        cursor_x: s.cursor_x,
        cursor_y: s.cursor_y,
        drag_x: s.drag_x,
        drag_y: s.drag_y,
        ticks: s.ticks,
        message: s.message,
        redraw: true
    })
    game

# The pointer's tile, and whether it moved: the preview follows it, and a
# frame is redrawn when it lands on a new tile.
nomethod fn with_cursor(game: Game, cursor_x: int, cursor_y: int) -> Game:
    s = state(game)
    same = cursor_x == s.cursor_x and cursor_y == s.cursor_y
    put(game, State {
        city: s.city,
        tool: s.tool,
        speed: s.speed,
        origin_x: s.origin_x,
        origin_y: s.origin_y,
        cursor_x: cursor_x,
        cursor_y: cursor_y,
        drag_x: s.drag_x,
        drag_y: s.drag_y,
        ticks: s.ticks,
        message: s.message,
        redraw: s.redraw or not same
    })
    game

# The tile the drag is on: the last tile the pointer crossed with the button
# held, and (-1, -1) when the button is not held on the map. It is where the
# next move event walks a line from, so a drag Raven coalesced into one event
# still crosses every tile it passed over.
nomethod fn with_drag(game: Game, drag_x: int, drag_y: int) -> Game:
    s = state(game)
    put(game, State {
        city: s.city,
        tool: s.tool,
        speed: s.speed,
        origin_x: s.origin_x,
        origin_y: s.origin_y,
        cursor_x: s.cursor_x,
        cursor_y: s.cursor_y,
        drag_x: drag_x,
        drag_y: drag_y,
        ticks: s.ticks,
        message: s.message,
        redraw: s.redraw
    })
    game

# --- The window ------------------------------------------------------------

nomethod fn build(city: simcity::city::City) -> Game errors NonFiniteFloat:
    window = raven::window("SimCity", WINDOW_WIDE, WINDOW_TALL)
    # The window reports its keys, mouse buttons, pointer moves and wheel from
    # now on. Watching consumes nothing: every control in it still takes its
    # own click, its own key and its own change, which is why the map asks
    # whether the pointer is inside its own rectangle before it builds.
    window.watch_input(true)
    funds = raven::label(simcity::words::show_funds(city))
    people = raven::label(simcity::words::show_people(city))
    jobs = raven::label(simcity::words::show_jobs(city))
    date = raven::label(simcity::words::show_date(city))
    tempo = raven::label(speed_label(Speed::Month))
    want_r = raven::label(simcity::words::show_demand(city, 0))
    want_c = raven::label(simcity::words::show_demand(city, 1))
    want_i = raven::label(simcity::words::show_demand(city, 2))
    note = raven::label("Build something.")
    # The file a save is written to and read from: a text field, because a
    # fixed filename would leave a player with one city and no way to a second.
    path = raven::text_input(SAVE_PATH)
    tax = raven::spin_box(0.0, 20.0)
    tax.set_spin_box_value(std::float64::from_int(simcity::city::tax_rate(city)))
    top = raven::hbox().add(funds).add(people).add(jobs).add(date).add(tempo)
    demand = raven::hbox().add(want_r).add(want_c).add(want_i)
    map = raven::Widget {id: raven::widget::Rwidget_create(raven::widget::R_WIDGET_IMAGE)}
    map.id.Rwidget_set_size(screen_width(), screen_height())
    # The map sits in a box that holds its own size, so the row beside it can
    # never stretch it into rectangles rather than squares. The image itself
    # stays what Game.map names: it is the image that the texture is uploaded
    # into and whose rect the pointer is aimed at.
    map_box = raven::Widget {id: raven::widget::Rwidget_create(raven::widget::R_WIDGET_SIZE_BOX)}
    map_box.add(map)
    map_box.id.Rwidget_set_size(screen_width(), screen_height())
    sides = simcity::toolbar::column()
    # The palette is held to its own height too, and it is shorter than the map,
    # so neither pushes the other about.
    tool_box = raven::Widget {id: raven::widget::Rwidget_create(raven::widget::R_WIDGET_SIZE_BOX)}
    tool_box.add(sides)
    tool_box.id.Rwidget_set_size(std::float64::from_int(TOOL_WIDE), std::float64::from_int(screen_tall() + VIEW_ROW))
    # The scroll buttons sit directly under the map, because they move the map:
    # the viewport is a quarter of the map, so a player who builds on one side
    # of the city has to reach the other.
    view = simcity::toolbar::view_move()
    map_column = raven::vbox().add(map_box).add(view)
    body = raven::hbox().add(map_column).add(tool_box)
    lower = raven::hbox().add(note).add(path).add(tax)
    column = raven::vbox().add(top).add(demand).add(body).add(lower)
    window.set_content(column)
    started = State {
        city: city,
        tool: simcity::city::Tool::None,
        speed: Speed::Month,
        origin_x: 0,
        origin_y: 0,
        cursor_x: -1,
        cursor_y: -1,
        drag_x: -1,
        drag_y: -1,
        ticks: 0,
        message: "Build something.",
        redraw: true
    }
    Game {
        state: std::mutable_array::create(1, started),
        clock: raven::timer(0.1, true),
        window: window,
        map: map,
        tools: sides,
        funds: funds,
        people: people,
        jobs: jobs,
        date: date,
        tempo: tempo,
        want_r: want_r,
        want_c: want_c,
        want_i: want_i,
        note: note,
        path: path,
        tax: tax
    }

nomethod fn clear(game: Game) -> Game:
    s = state(game)
    put(game, State {
        city: s.city,
        tool: s.tool,
        speed: s.speed,
        origin_x: s.origin_x,
        origin_y: s.origin_y,
        cursor_x: s.cursor_x,
        cursor_y: s.cursor_y,
        drag_x: s.drag_x,
        drag_y: s.drag_y,
        ticks: s.ticks,
        message: s.message,
        redraw: false
    })
    game

# --- Showing the game ------------------------------------------------------

# The map's texture: made when the city or the cursor changes, and nothing
# uploaded while the pointer only moves between two tiles.
nomethod fn map_file(game: Game) -> Game:
    s = state(game)
    if not s.redraw:
        game
    else:
        at = simcity::city::pack(s.cursor_x, s.cursor_y)
        pixels = simcity::render::frame(s.city, s.origin_x, s.origin_y, ACROSS, DOWN, at)
        wide = simcity::render::TILE * ACROSS
        tall = simcity::render::TILE * DOWN
        opened = simcity::screen::open(wide, tall):
            on simcity::screen::OutOfRange:
                unit
        fresh = simcity::screen::texture_of(std::abi::bytes::from_list(pixels), wide, tall):
            on IndexNotFound:
                simcity::screen::none_texture()
            on simcity::screen::OutOfRange:
                simcity::screen::none_texture()
        game.map.id.Rimage_set_texture(fresh)
        clear(game)

nomethod fn show(game: Game) -> Game:
    s = state(game)
    game.funds.set_text(simcity::words::show_funds(s.city))
    game.people.set_text(simcity::words::show_people(s.city))
    game.jobs.set_text(simcity::words::show_jobs(s.city))
    game.date.set_text(simcity::words::show_date(s.city))
    game.tempo.set_text(speed_label(s.speed))
    game.want_r.set_text(simcity::words::show_demand(s.city, 0))
    game.want_c.set_text(simcity::words::show_demand(s.city, 1))
    game.want_i.set_text(simcity::words::show_demand(s.city, 2))
    game.note.set_text(s.message)
    map_file(game)

# --- The pointer -----------------------------------------------------------
#
# Raven 0.4.0 reports a watched window's input, and the map reads it the two
# ways the package means it to be read. "Did the player press?" is an event:
# `MousePressed` arrives once per press however long the button is held, so a
# construction happens once and a held button spends nothing more. "Is it held
# now, and where is the pointer?" is the state: `mouse_button_down?` for the
# button, and the coordinates every input event carries.
#
# A drag is both at once: the move events, with the button's state asked of the
# window rather than assumed. Raven coalesces the pointer moves of one frame
# into a single `MouseMoved`, so the tiles between two observed positions are
# walked here rather than assumed -- a fast drag crosses every tile it passed
# over, and a slow one costs nothing extra.
#
# The pointer's coordinates are the window's logical units and so is the map's
# rectangle, so the tile under a point is a subtraction and a division. A point
# outside the map's rectangle is no tile at all -- not the tile at the edge,
# and not the origin -- which is what keeps a click on the palette, on a label,
# on the scroll row or in the save field from building on the map. The x and
# the y are two numbers of one record (`raven::Point`, or an event's `x` and
# `y`), not two out-parameters that could be given one address: the aliasing
# that once coupled them cannot be expressed through this interface.

# A tile of the map, as the row and column the game builds on. (-1, -1) is no
# tile, which is what a point off the map answers.
struct Place:
    x: int
    y: int

nomethod fn place_of(x: int, y: int) -> Place:
    Place {x: x, y: y}

# No tile: the pointer is outside the map.
nomethod fn nowhere() -> Place:
    place_of(-1, -1)

# The distance from the map's edge to PX. The two are finite -- Raven answers
# finite numbers -- but a Float64 subtraction can still overflow, and a
# distance that is no number is a point that is nowhere on the map, which is
# what it answers.
nomethod fn offset(px: Float64, edge: Float64) -> Float64:
    moved = px - edge:
        on NonFiniteFloat:
            -1.0
    moved

# The tile the window point (PX, PY) is on, or none. The map's rectangle is
# where the last frame laid it out, in the window's logical units, and the
# pointer's coordinates are the same units, so the conversion needs no native
# memory of this game's own: Raven answers a Point and a Rect, both finite.
nomethod fn tile_at(map: raven::Rect, origin_x: int, origin_y: int, px: Float64, py: Float64) -> Place:
    x = offset(px, map.x)
    y = offset(py, map.y)
    if x < 0.0 or y < 0.0 or x >= map.width or y >= map.height:
        nowhere()
    else:
        place_of(origin_x + simcity::render::div(whole(x), TILE_PX), origin_y + simcity::render::div(whole(y), TILE_PX))

# The tiles a drag crosses from (from_x, from_y) to (to_x, to_y): the first is
# excluded, because it is where the press or the last move already built, and
# the last is included, because it is where the pointer is now. The steps are
# the line's, at one tile of resolution, so no tile the pointer passed over is
# skipped and none is visited twice.
nomethod fn steps_between(from_x: int, from_y: int, to_x: int, to_y: int) -> List[Place]:
    dx = to_x - from_x
    dy = to_y - from_y
    far_x = if dx < 0:
        -dx
    else:
        dx
    far_y = if dy < 0:
        -dy
    else:
        dy
    count = if far_x > far_y:
        far_x
    else:
        far_y
    if count <= 0:
        []
    else:
        loop i from 1 to count + 1:
            step_x = if dx < 0:
                -simcity::render::div(-2 * i * dx + count, 2 * count)
            else:
                simcity::render::div(2 * i * dx + count, 2 * count)
            step_y = if dy < 0:
                -simcity::render::div(-2 * i * dy + count, 2 * count)
            else:
                simcity::render::div(2 * i * dy + count, 2 * count)
            place_of(from_x + step_x, from_y + step_y)

# One construction action on the tile (X, Y), and what the rules say about it:
# the tool is placed where it fits and charged for, a refusal says why, and the
# inspector reads the tile instead of changing it.
nomethod fn build_at(game: Game, x: int, y: int) -> Game:
    s = state(game)
    if s.tool == Tool::Inspect:
        with_message(game, simcity::words::show_tile(s.city, x, y))
    else:
        outcome = simcity::actions::fits(s.city, s.tool, x, y)
        if outcome == simcity::actions::Placed::Built:
            with_city(game, simcity::actions::place(s.city, s.tool, x, y))
        else:
            with_message(game, simcity::words::show_refusal(s.city, s.tool, x, y, outcome))

# Builds along the tiles from (from_x, from_y) to (to_x, to_y) and leaves the
# drag on the last of them: a line runs a tile at a time, and the treasury is
# charged for each tile that was actually built.
nomethod fn drag_along(game: Game, from_x: int, from_y: int, to_x: int, to_y: int) -> Game:
    places = steps_between(from_x, from_y, to_x, to_y)
    built = fold stop in places with intermediate made game:
        if simcity::city::inside?(state(made).city, stop.x, stop.y):
            build_at(made, stop.x, stop.y)
        else:
            made
    with_drag(built, to_x, to_y)

# The left button went down. On the map it is one construction action on the
# tile under the pointer, and the start of a drag. Anywhere else -- the
# palette, a label, the scroll row, the save field, the tax box -- the pointer
# is not inside the map's rectangle, so the map builds nothing and Raven's own
# control takes its click exactly as it would without the input hook.
nomethod fn press(game: Game, event: raven::Event, map: raven::Rect) -> Game:
    s = state(game)
    at = tile_at(map, s.origin_x, s.origin_y, event.x, event.y)
    if at.x < 0:
        with_cursor(game, -1, -1)
    else:
        started = with_cursor(game, at.x, at.y)
        with_drag(build_at(started, at.x, at.y), at.x, at.y)

# The pointer moved. The preview follows it. A drag -- the button held since a
# press on the map -- builds along the tiles the pointer crossed, and the
# button's state is asked of the window rather than inferred from the events:
# it is the one question the events do not answer, and a button let go outside
# the window must not go on building.
nomethod fn move_pointer(game: Game, event: raven::Event, map: raven::Rect) -> Game:
    s = state(game)
    at = tile_at(map, s.origin_x, s.origin_y, event.x, event.y)
    shown = with_cursor(game, at.x, at.y)
    t = state(shown)
    held = shown.window.mouse_button_down?(raven::window::R_MOUSE_LEFT)
    if at.x < 0:
        with_drag(shown, -1, -1)
    elif t.drag_x >= 0 and held:
        drag_along(shown, t.drag_x, t.drag_y, at.x, at.y)
    else:
        shown

# The left button went up: the drag is over, and a pointer that moves after it
# builds nothing until it is pressed on the map again.
nomethod fn release(game: Game) -> Game:
    with_drag(game, -1, -1)

# The tile the pointer is over right now, read from the window: the preview
# follows the pointer, and this is what a test aims at.
nomethod fn where_is_the_cursor(game: Game) -> Place:
    s = state(game)
    map = raven::rect(game.map)
    here = raven::mouse_position(game.window)
    tile_at(map, s.origin_x, s.origin_y, here.x, here.y)

# --- What the player does --------------------------------------------------

# --- The view ---------------------------------------------------------------

# The farthest the view may scroll to: a view whose last row is the map's last
# row, and never one row past it, because a view showing ground that is not on
# the map shows nothing.
nomethod fn keep_within(want: int, room: int, span: int) -> int:
    if want < 0:
        0
    elif want > room - span:
        room - span
    else:
        want

# Moving the view to (X, Y), clamped to the map: a scroll never shows past the
# map's edge, and never moves when it has nowhere left to go.
nomethod fn scrolled_to(game: Game, origin_x: int, origin_y: int) -> Game:
    s = state(game)
    x = keep_within(origin_x, simcity::city::width(s.city), ACROSS)
    y = keep_within(origin_y, s.city.height, DOWN)
    with_view(game, x, y)

# The view moved one step in a direction. A step is a screen less two rows, so
# the view the player is looking at is never replaced by one that shares
# nothing with it.
nomethod fn scroll(game: Game, dx: int, dy: int) -> Game:
    s = state(game)
    if dx > 0:
        scrolled_to(game, s.origin_x + VIEW_STEP_ACROSS, s.origin_y)
    elif dx < 0:
        scrolled_to(game, s.origin_x - VIEW_STEP_ACROSS, s.origin_y)
    elif dy > 0:
        scrolled_to(game, s.origin_x, s.origin_y + VIEW_STEP_DOWN)
    else:
        scrolled_to(game, s.origin_x, s.origin_y - VIEW_STEP_DOWN)

# --- Saving and loading -----------------------------------------------------
#
# A save is a file a player can read, and a load is a city that comes back as
# the city that was saved. Both go through the raw layer (simcity::store) for
# the file, and the codec (simcity::save) for the format: the game itself only
# knows a path and a city.

# The file the path field names right now.
nomethod fn save_path(game: Game) -> str:
    raven::input_text(game.path)

# Writing the city to that file, and saying what happened.
nomethod fn save_city(game: Game) -> Game:
    path = save_path(game)
    text = simcity::save::describe(state(game).city)
    written = simcity::store::wrote(path, text):
        on simcity::store::StoreFailed:
            false
    if written:
        with_message(game, "Saved ".concat(path).append_char('.'))
    else:
        with_message(game, "Could not write ".concat(path).append_char('.'))

# The city a save's text describes, made the game's own.
nomethod fn read_back(game: Game, text: str) -> Game:
    city = simcity::save::rebuild(text):
        on simcity::save::BadSave:
            state(game).city
    with_city(with_view(game, 0, 0), city)

# Reading the city back from that file, and saying what happened. A file that
# is not a save leaves the city exactly as it was: a load that half-happened is
# worse than one that did not.
nomethod fn load_city(game: Game) -> Game:
    path = save_path(game)
    text = simcity::store::read(path):
        on simcity::store::StoreFailed:
            ""
        on simcity::store::NotText:
            ""
        on NativeViewNull:
            ""
        on UpperOverrun:
            ""
    found = std::str::length(text) > 0
    if found:
        loaded = read_back(game, text)
        with_message(loaded, "Loaded ".concat(path).append_char('.'))
    else:
        with_message(game, "Nothing to load at ".concat(path).append_char('.'))

nomethod fn budget_line(city: simcity::city::City) -> str:
    simcity::words::show_income(city).concat(", ").concat(simcity::words::show_upkeep(city)).concat(", ").concat(simcity::words::show_balance(city))

nomethod fn begin(game: Game) -> Game:
    fresh = simcity::city::make(MAP_WIDE, MAP_TALL, 4242, 20000)
    restarted = with_city(game, fresh)
    with_message(restarted, "A new town on new land.")

nomethod fn inspect(game: Game) -> Game:
    with_message(with_tool(game, simcity::city::Tool::Inspect), "Inspect: click a tile to read what is on it.")

nomethod fn rate(game: Game) -> Game:
    value = raven::spin_box_value(game.tax):
        on NonFiniteFloat:
            std::float64::from_int(7)
    with_city(game, simcity::city::with_bank(state(game).city, simcity::city::TAX, rate_of(value)))

nomethod fn act(game: Game, name: str) -> Game:
    if name == "tempo.pause":
        with_speed(game, Speed::Paused)
    elif name == "tempo.month":
        with_speed(game, Speed::Month)
    elif name == "tempo.rush":
        with_speed(game, Speed::Rush)
    elif name == "tool.road":
        with_tool(game, simcity::city::Tool::Road)
    elif name == "tool.wire":
        with_tool(game, simcity::city::Tool::Wire)
    elif name == "tool.rail":
        with_tool(game, simcity::city::Tool::Rail)
    elif name == "tool.residential":
        with_tool(game, simcity::city::Tool::Residential)
    elif name == "tool.commercial":
        with_tool(game, simcity::city::Tool::Commercial)
    elif name == "tool.industrial":
        with_tool(game, simcity::city::Tool::Industrial)
    elif name == "tool.coal":
        with_tool(game, simcity::city::Tool::Coal)
    elif name == "tool.nuclear":
        with_tool(game, simcity::city::Tool::Nuclear)
    elif name == "tool.police":
        with_tool(game, simcity::city::Tool::Police)
    elif name == "tool.fire":
        with_tool(game, simcity::city::Tool::Fire)
    elif name == "tool.park":
        with_tool(game, simcity::city::Tool::Park)
    elif name == "tool.bulldoze":
        with_tool(game, simcity::city::Tool::Bulldoze)
    elif name == "tool.inspect":
        inspect(game)
    elif name == "budget":
        with_message(game, budget_line(state(game).city))
    elif name == "new":
        begin(game)
    elif name == "save":
        save_city(game)
    elif name == "load":
        load_city(game)
    elif name == "view.left":
        scroll(game, -1, 0)
    elif name == "view.right":
        scroll(game, 1, 0)
    elif name == "view.up":
        scroll(game, 0, -1)
    elif name == "view.down":
        scroll(game, 0, 1)
    else:
        game

# --- The keys, and the wheel ------------------------------------------------
#
# The view moves with the four arrow keys, and a key press is an event: one
# `KeyPressed` per press, however long the key is held. Raven's own auto-repeat
# arrives as `KeyRepeated` and is deliberately not acted on, which is the
# behaviour the polled mask had -- a held key moves the view one step and then
# waits to be released. No other key does anything.
#
# The wheel scrolls the view, one step a line: the same step the arrow keys and
# the four buttons under the map move it by, because that is the one scrolling
# this game does -- there is no zoom for a wheel to scale. A `Wheel` event is
# answered here rather than dropped by falling through, so it can never be
# mistaken for a construction, and the view is the only thing it moves.

# A key went down: the four arrow keys move the view one step.
nomethod fn key_press(game: Game, key: int) -> Game:
    if key == raven::window::R_KEY_LEFT:
        scroll(game, -1, 0)
    elif key == raven::window::R_KEY_RIGHT:
        scroll(game, 1, 0)
    elif key == raven::window::R_KEY_UP:
        scroll(game, 0, -1)
    elif key == raven::window::R_KEY_DOWN:
        scroll(game, 0, 1)
    else:
        game

# The wheel turned: the view moves one step a line, up and left positive. A
# turn is never a construction.
nomethod fn wheel_turn(game: Game, event: raven::Event) -> Game:
    if event.dy > 0.5:
        scroll(game, 0, -1)
    elif event.dy < -0.5:
        scroll(game, 0, 1)
    elif event.dx > 0.5:
        scroll(game, -1, 0)
    elif event.dx < -0.5:
        scroll(game, 1, 0)
    else:
        game

# One event of a watched window, answered: what the controls report, what the
# keys do, and what the pointer and the wheel do. An event nobody here claims is
# dropped -- a held key's auto-repeat (`KeyRepeated`) among them, which is what
# makes a held key move the view once.
nomethod fn accept(game: Game, event: raven::Event, map: raven::Rect) -> Game:
    if event.kind == raven::EventKind::Action:
        act(game, event.text)
    elif event.kind == raven::EventKind::ValueChanged:
        rate(game)
    elif event.kind == raven::EventKind::KeyPressed:
        key_press(game, event.value)
    elif event.kind == raven::EventKind::MousePressed and event.value == raven::window::R_MOUSE_LEFT:
        press(game, event, map)
    elif event.kind == raven::EventKind::MouseMoved:
        move_pointer(game, event, map)
    elif event.kind == raven::EventKind::MouseReleased:
        release(game)
    elif event.kind == raven::EventKind::Wheel:
        wheel_turn(game, event)
    else:
        game

# One frame's events, taken and answered. The game's loop drives exactly this,
# so what a test drives by injecting input is the code the game runs.
nomethod fn take_events(game: Game) -> Game:
    map = raven::rect(game.map)
    fold event in raven::events() with intermediate s game:
        accept(s, event, map)

# --- The loop --------------------------------------------------------------
#
# One frame: wait for it, answer its events, run the city's clock, draw. The
# events are what a click is -- one press, one construction -- so the loop no
# longer derives a press by comparing one frame's button state with the last,
# and a button held still spends nothing because nothing is delivered.

# One simulated month when the tempo's worth of timer ticks has gone by, and
# the city keeps running while the player is, because a frame never blocks.
nomethod fn month(game: Game) -> Game:
    s = state(game)
    ticks = s.ticks + 1
    rate = speed_rate(s.speed)
    enough = rate > 0 and ticks >= rate
    grown = if enough:
        simcity::sim::tick(s.city)
    else:
        s.city
    next_ticks = if enough:
        0
    else:
        ticks
    put(game, State {
        city: grown,
        tool: s.tool,
        speed: s.speed,
        origin_x: s.origin_x,
        origin_y: s.origin_y,
        cursor_x: s.cursor_x,
        cursor_y: s.cursor_y,
        drag_x: s.drag_x,
        drag_y: s.drag_y,
        ticks: next_ticks,
        message: s.message,
        redraw: s.redraw or enough
    })
    game

nomethod fn run(game: Game) -> unit:
    awake = raven::wait_frame(-1.0)
    if not awake:
        unit
    else:
        heard = take_events(game)
        next = month(heard)
        shown = show(next)
        run(shown)

nomethod fn start(city: simcity::city::City, how: raven::Options) -> str errors NonFiniteFloat:
    begun = raven::start(how):
        on raven::RavenFailed failure:
            unit
    game = build(city):
        on NonFiniteFloat:
            build(simcity::city::make(48, 48, 7, 20000))
    first = raven::draw_frame():
        on NonFiniteFloat:
            false
    shown = show(game)
    last = run(shown)
    raven::stop()
    "closed"
