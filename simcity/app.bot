# simcity::app -- the game's window, its controls, and the loop that runs both.
#
# This module is where the simulation meets Raven. It holds the city (a value
# the simulation owns), reads what the mouse does as construction, and copies
# the city's figures onto the controls. It contains no simulation rules of its
# own: every number it shows comes out of simcity::sim, and every change it
# makes goes in through simcity::actions.
#
# The loop is a recursion of a function over its own state, which the native
# backends run as a loop: one frame, its events, one month of city time when
# the clock says so, and the next frame. A timer ticks every tenth of a second
# and its events are what wake the loop, so the city advances whether the
# player is clicking or not.
#
# The game's mutable state is one struct held in a one-slot MutableArray,
# because Botlish structs have no field assignment: a change is a new struct
# and a write into the array. That is the price of immutable records here, paid
# once in `put` and the `State` literals rather than spread over the program.
import std::abi::bytes
import std::ffi::c
import std::float64
import std::int
import std::list
import std::mutable_array
import std::str
import type simcity::city::Tool
import raven
import raven::controls
import raven::widget
import raven::window
import simcity::actions
import simcity::city
import simcity::render
import simcity::save
import simcity::screen
import simcity::store
import simcity::sim
import simcity::toolbar
import simcity::words

# --- The shape of the game -------------------------------------------------

# Map tiles the viewport shows, and screen pixels per map tile. A viewport of
# 32 by 22 tiles is what fits beside a 500-point palette in a window that is
# still small enough for a laptop screen, and it is a quarter of the map, so
# there is a city to scroll through rather than a city that is all on screen.
ACROSS = 32
DOWN = 22
TILE_PX = 16
# The map a new town starts on: four times the area of the viewport, so the
# player has to choose where to build rather than building everywhere at once.
MAP_WIDE = 64
MAP_TALL = 64
# How far the view moves at one step of a scroll button: a screen less a couple
# of rows of overlap, so a scroll never hides the ground the player was looking
# at and the next view still shows where the last one ended.
VIEW_STEP_ACROSS = ACROSS - 2
VIEW_STEP_DOWN = DOWN - 2
# The palette's width in screen pixels.
TOOL_WIDE = 500
# The file a save starts as. A player types over it: the field is there so a
# city can be kept in more than one place.
SAVE_PATH = "simcity.save"

# The window, sized so the map and the palette fit beside each other inside it:
# a control laid out outside the window is neither drawn nor clickable, which
# is the bug the three-column palette was built to avoid.
WINDOW_WIDE = 1040
WINDOW_TALL = 620

# How fast the city runs: a choice of simulated month per timer tick. A tick
# of the timer is a tenth of a second, so "month" is a month every half a
# second and "rush" is ten a second.
enum Speed:
    Paused,
    Month,
    Rush

# The mutable part of the game: the city and where the player stands.
struct State:
    city: simcity::city::City
    tool: simcity::city::Tool
    speed: Speed
    origin_x: int
    origin_y: int
    cursor_x: int
    cursor_y: int
    held: bool
    ticks: int
    keys: int
    message: str
    redraw: bool

# Everything the game holds: its state, and the widgets that show it.
struct Game:
    state: MutableArray[State]
    window: raven::Window
    map: raven::Widget
    tools: raven::Widget
    funds: raven::Widget
    people: raven::Widget
    jobs: raven::Widget
    date: raven::Widget
    tempo: raven::Widget
    want_r: raven::Widget
    want_c: raven::Widget
    want_i: raven::Widget
    note: raven::Widget
    path: raven::Widget
    tax: raven::Widget
    clock: raven::Timer

# --- Small helpers ---------------------------------------------------------

nomethod fn whole(value: Float64) -> int:
    if value < 0.0:
        0
    else:
        std::float64::truncate(value)

nomethod fn speed_label(speed: Speed) -> str:
    if speed == Speed::Paused:
        "Tempo: paused"
    elif speed == Speed::Month:
        "Tempo: month"
    else:
        "Tempo: rush"

nomethod fn screen_width() -> Float64:
    std::float64::from_int(TILE_PX * ACROSS)

nomethod fn screen_height() -> Float64:
    std::float64::from_int(TILE_PX * DOWN)

# The map box alone, without the scroll row under it: the palette beside it is
# held to this, so the two columns of the body end at the same edge.
nomethod fn screen_tall() -> int:
    TILE_PX * DOWN

# The points a scroll row of buttons takes up, alongside the map: enough for
# one row of controls and no more, so the map stays the tall thing in its
# column.
VIEW_ROW = 34

# Simulated months per timer tick.
nomethod fn speed_rate(speed: Speed) -> int:
    if speed == Speed::Paused:
        0
    elif speed == Speed::Month:
        5
    else:
        1

nomethod fn rate_of(value: Float64) -> int:
    if value < 0.0:
        0
    elif value > 20.0:
        20
    else:
        std::float64::truncate(value)

# --- A state, and changing one part of it ----------------------------------

nomethod fn no_state() -> State:
    State {
        city: simcity::city::make(8, 8, 1, 0),
        tool: simcity::city::Tool::None,
        speed: Speed::Month,
        origin_x: 0,
        origin_y: 0,
        cursor_x: -1,
        cursor_y: -1,
        held: false,
        ticks: 0,
        keys: 0,
        message: "nothing here",
        redraw: false
    }

nomethod fn state(game: Game) -> State:
    if 0 < game.state.capacity():
        std::mutable_array::at(game.state, 0)
    else:
        no_state()

# Writes S into the caller's own state, in place.
nomethod fn put(place game: Game, s: State) -> unit:
    if 0 < game.state.capacity():
        game.state.set(0, s)
    else:
        unit

nomethod fn with_city(game: Game, city: simcity::city::City) -> Game:
    s = state(game)
    put(game, State {
        city: city,
        tool: s.tool,
        speed: s.speed,
        origin_x: s.origin_x,
        origin_y: s.origin_y,
        cursor_x: s.cursor_x,
        cursor_y: s.cursor_y,
        held: s.held,
        ticks: s.ticks,
        keys: s.keys,
        message: s.message,
        redraw: true
    })
    game

nomethod fn with_message(game: Game, text: str) -> Game:
    s = state(game)
    put(game, State {
        city: s.city,
        tool: s.tool,
        speed: s.speed,
        origin_x: s.origin_x,
        origin_y: s.origin_y,
        cursor_x: s.cursor_x,
        cursor_y: s.cursor_y,
        held: s.held,
        ticks: s.ticks,
        keys: s.keys,
        message: text,
        redraw: true
    })
    game

nomethod fn with_tool(game: Game, tool: Tool) -> Game:
    s = state(game)
    put(game, State {
        city: s.city,
        tool: tool,
        speed: s.speed,
        origin_x: s.origin_x,
        origin_y: s.origin_y,
        cursor_x: s.cursor_x,
        cursor_y: s.cursor_y,
        held: s.held,
        ticks: s.ticks,
        keys: s.keys,
        message: simcity::words::show_tool(tool).concat(", ").concat(simcity::words::show_cost(tool)),
        redraw: true
    })
    game

nomethod fn with_speed(game: Game, speed: Speed) -> Game:
    s = state(game)
    put(game, State {
        city: s.city,
        tool: s.tool,
        speed: speed,
        origin_x: s.origin_x,
        origin_y: s.origin_y,
        cursor_x: s.cursor_x,
        cursor_y: s.cursor_y,
        held: s.held,
        ticks: s.ticks,
        keys: s.keys,
        message: speed_label(speed),
        redraw: true
    })
    game

nomethod fn with_view(game: Game, origin_x: int, origin_y: int) -> Game:
    s = state(game)
    put(game, State {
        city: s.city,
        tool: s.tool,
        speed: s.speed,
        origin_x: origin_x,
        origin_y: origin_y,
        cursor_x: s.cursor_x,
        cursor_y: s.cursor_y,
        held: s.held,
        ticks: s.ticks,
        keys: s.keys,
        message: s.message,
        redraw: true
    })
    game

# The pointer's tile, and whether it moved: the preview follows it, and a
# frame is redrawn when it lands on a new tile.
nomethod fn with_cursor(game: Game, cursor_x: int, cursor_y: int, held: bool) -> Game:
    s = state(game)
    same = cursor_x == s.cursor_x and cursor_y == s.cursor_y and held == s.held
    put(game, State {
        city: s.city,
        tool: s.tool,
        speed: s.speed,
        origin_x: s.origin_x,
        origin_y: s.origin_y,
        cursor_x: cursor_x,
        cursor_y: cursor_y,
        held: held,
        ticks: s.ticks,
        keys: s.keys,
        message: s.message,
        redraw: s.redraw or not same
    })
    game

# --- The window ------------------------------------------------------------

nomethod fn build(city: simcity::city::City) -> Game errors NonFiniteFloat:
    window = raven::window("SimCity", WINDOW_WIDE, WINDOW_TALL)
    funds = raven::label(simcity::words::show_funds(city))
    people = raven::label(simcity::words::show_people(city))
    jobs = raven::label(simcity::words::show_jobs(city))
    date = raven::label(simcity::words::show_date(city))
    tempo = raven::label(speed_label(Speed::Month))
    want_r = raven::label(simcity::words::show_demand(city, 0))
    want_c = raven::label(simcity::words::show_demand(city, 1))
    want_i = raven::label(simcity::words::show_demand(city, 2))
    note = raven::label("Build something.")
    # The file a save is written to and read from: a text field, because a
    # fixed filename would leave a player with one city and no way to a second.
    path = raven::text_input(SAVE_PATH)
    tax = raven::spin_box(0.0, 20.0)
    tax.set_spin_box_value(std::float64::from_int(simcity::city::tax_rate(city)))
    top = raven::hbox().add(funds).add(people).add(jobs).add(date).add(tempo)
    demand = raven::hbox().add(want_r).add(want_c).add(want_i)
    map = raven::Widget {id: raven::widget::Rwidget_create(raven::widget::R_WIDGET_IMAGE)}
    map.id.Rwidget_set_size(screen_width(), screen_height())
    # The map sits in a box that holds its own size, so the row beside it can
    # never stretch it into rectangles rather than squares. The image itself
    # stays what Game.map names: it is the image that the texture is uploaded
    # into and whose rect the pointer is aimed at.
    map_box = raven::Widget {id: raven::widget::Rwidget_create(raven::widget::R_WIDGET_SIZE_BOX)}
    map_box.add(map)
    map_box.id.Rwidget_set_size(screen_width(), screen_height())
    sides = simcity::toolbar::column()
    # The palette is held to its own height too, and it is shorter than the map,
    # so neither pushes the other about.
    tool_box = raven::Widget {id: raven::widget::Rwidget_create(raven::widget::R_WIDGET_SIZE_BOX)}
    tool_box.add(sides)
    tool_box.id.Rwidget_set_size(std::float64::from_int(TOOL_WIDE), std::float64::from_int(screen_tall() + VIEW_ROW))
    # The scroll buttons sit directly under the map, because they move the map:
    # the viewport is a quarter of the map, so a player who builds on one side
    # of the city has to reach the other.
    view = simcity::toolbar::view_move()
    map_column = raven::vbox().add(map_box).add(view)
    body = raven::hbox().add(map_column).add(tool_box)
    lower = raven::hbox().add(note).add(path).add(tax)
    column = raven::vbox().add(top).add(demand).add(body).add(lower)
    window.set_content(column)
    started = State {
        city: city,
        tool: simcity::city::Tool::None,
        speed: Speed::Month,
        origin_x: 0,
        origin_y: 0,
        cursor_x: -1,
        cursor_y: -1,
        held: false,
        ticks: 0,
        keys: 0,
        message: "Build something.",
        redraw: true
    }
    Game {
        state: std::mutable_array::create(1, started),
        clock: raven::timer(0.1, true),
        window: window,
        map: map,
        tools: sides,
        funds: funds,
        people: people,
        jobs: jobs,
        date: date,
        tempo: tempo,
        want_r: want_r,
        want_c: want_c,
        want_i: want_i,
        note: note,
        path: path,
        tax: tax
    }

nomethod fn clear(game: Game) -> Game:
    s = state(game)
    put(game, State {
        city: s.city,
        tool: s.tool,
        speed: s.speed,
        origin_x: s.origin_x,
        origin_y: s.origin_y,
        cursor_x: s.cursor_x,
        cursor_y: s.cursor_y,
        held: s.held,
        ticks: s.ticks,
        keys: s.keys,
        message: s.message,
        redraw: false
    })
    game

# --- Showing the game ------------------------------------------------------

# The map's texture: made when the city or the cursor changes, and nothing
# uploaded while the pointer only moves between two tiles.
nomethod fn map_file(game: Game) -> Game:
    s = state(game)
    if not s.redraw:
        game
    else:
        at = simcity::city::pack(s.cursor_x, s.cursor_y)
        pixels = simcity::render::frame(s.city, s.origin_x, s.origin_y, ACROSS, DOWN, at)
        wide = simcity::render::TILE * ACROSS
        tall = simcity::render::TILE * DOWN
        opened = simcity::screen::open(wide, tall):
            on simcity::screen::OutOfRange:
                unit
        fresh = simcity::screen::texture_of(std::abi::bytes::from_list(pixels), wide, tall):
            on IndexNotFound:
                simcity::screen::none_texture()
            on simcity::screen::OutOfRange:
                simcity::screen::none_texture()
        game.map.id.Rimage_set_texture(fresh)
        clear(game)

nomethod fn show(game: Game) -> Game:
    s = state(game)
    game.funds.set_text(simcity::words::show_funds(s.city))
    game.people.set_text(simcity::words::show_people(s.city))
    game.jobs.set_text(simcity::words::show_jobs(s.city))
    game.date.set_text(simcity::words::show_date(s.city))
    game.tempo.set_text(speed_label(s.speed))
    game.want_r.set_text(simcity::words::show_demand(s.city, 0))
    game.want_c.set_text(simcity::words::show_demand(s.city, 1))
    game.want_i.set_text(simcity::words::show_demand(s.city, 2))
    game.note.set_text(s.message)
    map_file(game)

# --- The mouse -------------------------------------------------------------
#
# Raven reports control input through the package's event bridge, but the
# bridge watches named widget kinds only: nothing watches the map, which is a
# texture. So the map's mouse is read by polling the window, which is what a
# game does anyway: the pointer's position and the button's state, then the
# tile under it.

nomethod fn tile_under(game: Game) -> simcity::screen::Place errors NonFiniteFloat:
    laid_out = raven::rect(game.map):
        on NonFiniteFloat:
            raven::Rect {x: 0.0, y: 0.0, width: 0.0, height: 0.0}
    where = simcity::screen::mouse_at(game.window):
        on NonFiniteFloat:
            [0.0, 0.0]
        on NativeViewNull:
            [0.0, 0.0]
        on IndexNotFound:
            [0.0, 0.0]
        on simcity::screen::OutOfRange:
            [0.0, 0.0]
    x = std::list::get(where, 0, 0.0) - laid_out.x
    y = std::list::get(where, 1, 0.0) - laid_out.y
    s = state(game)
    tile = simcity::render::div(whole(x), TILE_PX):
        on NonFiniteFloat:
            0
    row = simcity::render::div(whole(y), TILE_PX):
        on NonFiniteFloat:
            0
    simcity::screen::place_of(s.origin_x + tile, s.origin_y + row)

# The tile the pointer is over right now, read from the window: the preview
# follows the pointer, and this is what a test aims at.
nomethod fn where_is_the_cursor(game: Game) -> simcity::screen::Place:
    under = tile_under(game):
        on NonFiniteFloat:
            simcity::screen::place_of(-1, -1)
    under

# --- What the player does --------------------------------------------------

# --- The view ---------------------------------------------------------------

# The farthest the view may scroll to: a view whose last row is the map's last
# row, and never one row past it, because a view showing ground that is not on
# the map shows nothing.
nomethod fn keep_within(want: int, room: int, span: int) -> int:
    if want < 0:
        0
    elif want > room - span:
        room - span
    else:
        want

# Moving the view to (X, Y), clamped to the map: a scroll never shows past the
# map's edge, and never moves when it has nowhere left to go.
nomethod fn scrolled_to(game: Game, origin_x: int, origin_y: int) -> Game:
    s = state(game)
    x = keep_within(origin_x, simcity::city::width(s.city), ACROSS)
    y = keep_within(origin_y, s.city.height, DOWN)
    with_view(game, x, y)

# The view moved one step in a direction. A step is a screen less two rows, so
# the view the player is looking at is never replaced by one that shares
# nothing with it.
nomethod fn scroll(game: Game, dx: int, dy: int) -> Game:
    s = state(game)
    if dx > 0:
        scrolled_to(game, s.origin_x + VIEW_STEP_ACROSS, s.origin_y)
    elif dx < 0:
        scrolled_to(game, s.origin_x - VIEW_STEP_ACROSS, s.origin_y)
    elif dy > 0:
        scrolled_to(game, s.origin_x, s.origin_y + VIEW_STEP_DOWN)
    else:
        scrolled_to(game, s.origin_x, s.origin_y - VIEW_STEP_DOWN)

# --- Saving and loading -----------------------------------------------------
#
# A save is a file a player can read, and a load is a city that comes back as
# the city that was saved. Both go through the raw layer (simcity::store) for
# the file, and the codec (simcity::save) for the format: the game itself only
# knows a path and a city.

# The file the path field names right now.
nomethod fn save_path(game: Game) -> str:
    raven::input_text(game.path)

# Writing the city to that file, and saying what happened.
nomethod fn save_city(game: Game) -> Game:
    path = save_path(game)
    text = simcity::save::describe(state(game).city)
    written = simcity::store::wrote(path, text):
        on simcity::store::StoreFailed:
            false
    if written:
        with_message(game, "Saved ".concat(path).append_char('.'))
    else:
        with_message(game, "Could not write ".concat(path).append_char('.'))

# The city a save's text describes, made the game's own.
nomethod fn read_back(game: Game, text: str) -> Game:
    city = simcity::save::rebuild(text):
        on simcity::save::BadSave:
            state(game).city
    with_city(with_view(game, 0, 0), city)

# Reading the city back from that file, and saying what happened. A file that
# is not a save leaves the city exactly as it was: a load that half-happened is
# worse than one that did not.
nomethod fn load_city(game: Game) -> Game:
    path = save_path(game)
    text = simcity::store::read(path):
        on simcity::store::StoreFailed:
            ""
        on simcity::store::NotText:
            ""
        on NativeViewNull:
            ""
        on UpperOverrun:
            ""
    found = std::str::length(text) > 0
    if found:
        loaded = read_back(game, text)
        with_message(loaded, "Loaded ".concat(path).append_char('.'))
    else:
        with_message(game, "Nothing to load at ".concat(path).append_char('.'))

nomethod fn budget_line(city: simcity::city::City) -> str:
    simcity::words::show_income(city).concat(", ").concat(simcity::words::show_upkeep(city)).concat(", ").concat(simcity::words::show_balance(city))

nomethod fn begin(game: Game) -> Game:
    fresh = simcity::city::make(MAP_WIDE, MAP_TALL, 4242, 20000)
    restarted = with_city(game, fresh)
    with_message(restarted, "A new town on new land.")

nomethod fn inspect(game: Game) -> Game:
    with_message(with_tool(game, simcity::city::Tool::Inspect), "Inspect: click a tile to read what is on it.")

nomethod fn rate(game: Game) -> Game:
    value = raven::spin_box_value(game.tax):
        on NonFiniteFloat:
            std::float64::from_int(7)
    with_city(game, simcity::city::with_bank(state(game).city, simcity::city::TAX, rate_of(value)))

nomethod fn act(game: Game, name: str) -> Game:
    if name == "tempo.pause":
        with_speed(game, Speed::Paused)
    elif name == "tempo.month":
        with_speed(game, Speed::Month)
    elif name == "tempo.rush":
        with_speed(game, Speed::Rush)
    elif name == "tool.road":
        with_tool(game, simcity::city::Tool::Road)
    elif name == "tool.wire":
        with_tool(game, simcity::city::Tool::Wire)
    elif name == "tool.rail":
        with_tool(game, simcity::city::Tool::Rail)
    elif name == "tool.residential":
        with_tool(game, simcity::city::Tool::Residential)
    elif name == "tool.commercial":
        with_tool(game, simcity::city::Tool::Commercial)
    elif name == "tool.industrial":
        with_tool(game, simcity::city::Tool::Industrial)
    elif name == "tool.coal":
        with_tool(game, simcity::city::Tool::Coal)
    elif name == "tool.nuclear":
        with_tool(game, simcity::city::Tool::Nuclear)
    elif name == "tool.police":
        with_tool(game, simcity::city::Tool::Police)
    elif name == "tool.fire":
        with_tool(game, simcity::city::Tool::Fire)
    elif name == "tool.park":
        with_tool(game, simcity::city::Tool::Park)
    elif name == "tool.bulldoze":
        with_tool(game, simcity::city::Tool::Bulldoze)
    elif name == "tool.inspect":
        inspect(game)
    elif name == "budget":
        with_message(game, budget_line(state(game).city))
    elif name == "new":
        begin(game)
    elif name == "save":
        save_city(game)
    elif name == "load":
        load_city(game)
    elif name == "view.left":
        scroll(game, -1, 0)
    elif name == "view.right":
        scroll(game, 1, 0)
    elif name == "view.up":
        scroll(game, 0, -1)
    elif name == "view.down":
        scroll(game, 0, 1)
    else:
        game

# --- The view, and the keys that move it ------------------------------------
#
# The map is four times the viewport, so the view has to move. Raven's event
# bridge reports named actions and value changes, and Raven does not hand a key
# press to it, so the keys are polled instead: the same mechanism the mouse
# uses, once a frame, from `simcity::screen::key_down`.
#
# Four keys, one bit each, so the previous frame's mask is one integer and a
# press is a bit that is set now and was not set before: a key held down moves
# the view one step and then waits to be released, which is what a key does.
KEY_LEFT = 1

KEY_RIGHT = 2

KEY_UP = 4

KEY_DOWN = 8

# The four arrow keys, as a mask: 0 for none of them, and one bit per key.
nomethod fn key_mask(game: Game) -> int:
    left = if simcity::screen::key_down(game.window, raven::window::R_KEY_LEFT):
        KEY_LEFT
    else:
        0
    right = if simcity::screen::key_down(game.window, raven::window::R_KEY_RIGHT):
        KEY_RIGHT
    else:
        0
    up = if simcity::screen::key_down(game.window, raven::window::R_KEY_UP):
        KEY_UP
    else:
        0
    down = if simcity::screen::key_down(game.window, raven::window::R_KEY_DOWN):
        KEY_DOWN
    else:
        0
    left + right + up + down

# WHETHER the key BIT is set now and was not set before: a key held down moves
# the view one step and then waits to be released, which is what a key does.
nomethod fn just_pressed(now: int, was: int, bit: int) -> bool:
    bit_and(now, bit) != 0 and bit_and(was, bit) == 0

# Reading the keys, and moving the view by one step for each one pressed
# since the last frame. The new mask is stored, so a held key moves the view
# once rather than once a frame.
nomethod fn read_keys(game: Game) -> Game:
    s = state(game)
    now = key_mask(game)
    moved = if just_pressed(now, s.keys, KEY_LEFT):
        scroll(game, -1, 0)
    elif just_pressed(now, s.keys, KEY_RIGHT):
        scroll(game, 1, 0)
    elif just_pressed(now, s.keys, KEY_UP):
        scroll(game, 0, -1)
    elif just_pressed(now, s.keys, KEY_DOWN):
        scroll(game, 0, 1)
    else:
        game
    t = state(moved)
    put(moved, State {
        city: t.city,
        tool: t.tool,
        speed: t.speed,
        origin_x: t.origin_x,
        origin_y: t.origin_y,
        cursor_x: t.cursor_x,
        cursor_y: t.cursor_y,
        held: t.held,
        ticks: t.ticks,
        keys: now,
        message: t.message,
        redraw: t.redraw
    })
    moved

nomethod fn accept(game: Game, event: raven::Event) -> Game:
    if event.kind == raven::EventKind::Action:
        act(game, event.text)
    elif event.kind == raven::EventKind::ValueChanged:
        rate(game)
    else:
        game

# --- The loop --------------------------------------------------------------

# The pointer and the button, read once a frame: a click builds, a drag runs
# a line, and the tile under the pointer is drawn as the placement preview.
nomethod fn read_mouse(game: Game) -> Game errors NonFiniteFloat:
    where = tile_under(game)
    button = simcity::screen::down?(game.window, raven::window::R_MOUSE_LEFT)
    s = state(game)
    if button and simcity::city::inside?(s.city, where.x, where.y):
        if s.tool == Tool::Inspect:
            looked = with_message(game, simcity::words::show_tile(s.city, where.x, where.y))
            with_cursor(looked, where.x, where.y, button)
        else:
            outcome = simcity::actions::fits(s.city, s.tool, where.x, where.y)
            if outcome == simcity::actions::Placed::Built:
                built = with_city(game, simcity::actions::place(s.city, s.tool, where.x, where.y))
                with_cursor(built, where.x, where.y, button)
            else:
                said = with_message(game, simcity::words::show_refusal(s.city, s.tool, where.x, where.y, outcome))
                with_cursor(said, where.x, where.y, button)
    else:
        with_cursor(game, where.x, where.y, button)

# One simulated month when the tempo's worth of timer ticks has gone by, and
# the city keeps running while the player is, because a frame never blocks.
nomethod fn month(game: Game) -> Game:
    s = state(game)
    ticks = s.ticks + 1
    rate = speed_rate(s.speed)
    enough = rate > 0 and ticks >= rate
    grown = if enough:
        simcity::sim::tick(s.city)
    else:
        s.city
    next_ticks = if enough:
        0
    else:
        ticks
    put(game, State {
        city: grown,
        tool: s.tool,
        speed: s.speed,
        origin_x: s.origin_x,
        origin_y: s.origin_y,
        cursor_x: s.cursor_x,
        cursor_y: s.cursor_y,
        held: s.held,
        ticks: next_ticks,
        keys: s.keys,
        message: s.message,
        redraw: s.redraw or enough
    })
    game

nomethod fn run(game: Game) -> unit errors NonFiniteFloat:
    awake = raven::wait_frame(-1.0)
    if not awake:
        unit
    else:
        heard = fold event in raven::events() with intermediate s game:
            accept(s, event)
        steered = read_keys(heard)
        moved = read_mouse(steered)
        next = month(moved)
        shown = show(next)
        run(shown)

nomethod fn start(city: simcity::city::City, how: raven::Options) -> str errors NonFiniteFloat:
    begun = raven::start(how):
        on raven::RavenFailed failure:
            unit
    game = build(city):
        on NonFiniteFloat:
            build(simcity::city::make(48, 48, 7, 20000))
    first = raven::draw_frame():
        on NonFiniteFloat:
            false
    shown = show(game)
    last = run(shown)
    raven::stop()
    "closed"
