# simcity::toolbar -- the palette of tools, as buttons.
#
# Each button carries a named action ("tool.road", "tempo.rush", "budget")
# and the game's loop reads those names. That is Raven's own mechanism for a
# control the program must recognise without knowing which widget it was, and
# it means this module does not have to hand a handle back for the game to
# compare against an event.
#
# The palette is three short columns side by side. A control is only clickable
# where the window draws it, and Raven lays a child out inside its parent's
# slot: a column of twenty controls was 486 points tall in a 304-point slot,
# so its bottom half was unreachable. Three columns of at most eight controls
# are shorter than the slot, and the game's own test reads the palette's rect
# back to prove it.
import type simcity::city::Tool
import raven
import std::str
import simcity::city
import simcity::words

# One button that fires the named action.
nomethod fn action(text: str, name: str) -> raven::Widget:
    made = raven::button(text)
    made.set_action(name)
    made

nomethod fn name_of(tool: Tool) -> str:
    if tool == Tool::Road:
        "road"
    elif tool == Tool::Wire:
        "wire"
    elif tool == Tool::Rail:
        "rail"
    elif tool == Tool::Residential:
        "residential"
    elif tool == Tool::Commercial:
        "commercial"
    elif tool == Tool::Industrial:
        "industrial"
    elif tool == Tool::Coal:
        "coal"
    elif tool == Tool::Nuclear:
        "nuclear"
    elif tool == Tool::Police:
        "police"
    elif tool == Tool::Fire:
        "fire"
    elif tool == Tool::Park:
        "park"
    elif tool == Tool::Bulldoze:
        "bulldoze"
    elif tool == Tool::Inspect:
        "inspect"
    else:
        "none"

# A tool's button: its name and its price.
nomethod fn tool(tool: Tool) -> raven::Widget:
    action(simcity::words::show_tool(tool).concat("  ").concat(simcity::words::show_cost(tool)), "tool.".concat(name_of(tool)))

# The tools that draw on the ground.
nomethod fn grounds() -> raven::Widget:
    raven::vbox().add(tool(Tool::Road)).add(tool(Tool::Wire)).add(tool(Tool::Rail)).add(tool(Tool::Residential)).add(tool(Tool::Commercial)).add(tool(Tool::Industrial)).add(tool(Tool::Bulldoze)).add(action("Inspect", "tool.inspect"))

# The tools that are built rather than drawn, and the key the map is labelled
# with: the letters stand for what is on the tile.
nomethod fn built() -> raven::Widget:
    tools = raven::vbox().add(tool(Tool::Coal)).add(tool(Tool::Nuclear)).add(tool(Tool::Police)).add(tool(Tool::Fire)).add(tool(Tool::Park)).add(raven::label("Key: R C I zones")).add(raven::label("P N power plants")).add(raven::label("O police F fire"))
    tools.add(raven::label("K park"))

# How fast the city runs, and the two things the player opens.
nomethod fn others() -> raven::Widget:
    tempos = raven::hbox().add(action("Pause", "tempo.pause")).add(action("Month", "tempo.month")).add(action("Rush", "tempo.rush"))
    raven::vbox().add(tempos).add(action("Budget", "budget")).add(action("New town", "new")).add(action("Save", "save")).add(action("Load", "load")).add(raven::label("Click to build, drag")).add(raven::label("to run a line, arrow")).add(raven::label("keys move the view."))

# The palette: three columns beside each other, so no column is deeper than
# the map is tall.
nomethod fn column() -> raven::Widget:
    raven::hbox().add(grounds()).add(built()).add(others())

# One character written as a string: Botlish writes a single character as a
# character literal, and every label Raven takes is a string, so the four
# scroll buttons' glyphs go through here.
nomethod fn one(c: UnicodeChar) -> str:
    "".append_char(c)

# The view's scroll buttons: the map is four times the viewport, and Raven's
# event bridge reports named actions but not keys, so the view moves by four
# buttons a player can always reach rather than by a key nothing hears.
nomethod fn view_move() -> raven::Widget:
    raven::hbox().add(action(one('<'), "view.left")).add(action(one('^'), "view.up")).add(action(one('v'), "view.down")).add(action(one('>'), "view.right"))
