# simcity::render -- the city as pixels.
#
# The map is drawn into one RGBA byte list which the game's screen uploads as
# a texture: TILE texture pixels to a side for every map tile, so a whole
# viewport is one list of bytes and redrawing one tile is redrawing one tile.
# Eight texture pixels per tile is enough room for the single letter that says
# what the object is, which is the whole point of the size: a 3 by 3 zoning
# block has no room for a word, but it has room for R, C, I, P, N, O, F or K.
#
# The letters are a five by five bitmap font drawn here as pixel patterns:
# the game has no font to draw with inside a texture, and a letter made of
# pixels is the same weight of work as a letter drawn by a library.
#
# A frame is built with collecting loops, because Botlish has no list
# concatenation: each loop collects its own rows, and the loops are nested so
# that the outermost one collects whole texture-pixel rows of the viewport.
#
# A colour is a packed integer, red in the high byte and blue in the low,
# because a module-level binding may not construct a struct -- a constant in
# Botlish is a number or a string, never a value of its own making.
#
# The three networks are told apart by colour *and* by the way they are drawn:
# a road is asphalt with a pale line down its middle, a rail is brown with
# sleepers, and a power line is a line of its own rather than a filled tile.
# The first cut of the game drew all three as a flat tile of nearly the same
# grey, which is a map you read by clicking on things to find out what they
# are. A line's direction is decided from its neighbours, so a run of road
# reads as a road from one end of it to the other.
import std::byte

import std::float64

import std::list

import type simcity::city::Tool

import simcity::actions

import simcity::city

# Texture pixels per map tile.
TILE = 8

# The side of a label's box inside a tile, and where the box begins.
LABEL = 5

LABEL_AT = 1

# Where a crossing's stripe begins, and how wide it is: the middle two rows or
# columns of the tile, so the wire shows across the carriageway it crosses.
CROSS_AT = 3

CROSS_WIDE = 2

# How many tiles a block of the map is, for the faint grid that gives the map
# a scale: a tile is eight pixels, so four of them are a square of thirty-two.
BLOCK = 4

#
# A number per letter, so the glyph table is a list of lists rather than a
# switch over strings.
LETTER_R = 1

LETTER_C = 2

LETTER_I = 3

LETTER_P = 4

LETTER_N = 5

LETTER_O = 6

LETTER_F = 7

LETTER_K = 8

# The letter a zoning category or a building is labelled with, and zero for
# the ground: one exit per answer, so the reader follows one decision.
nomethod fn letter_of(kind: int) -> int:
    if kind == simcity::city::RES:
        LETTER_R
    elif kind == simcity::city::COM:
        LETTER_C
    elif kind == simcity::city::IND:
        LETTER_I
    elif kind == simcity::city::COAL:
        LETTER_P
    elif kind == simcity::city::NUCLEAR:
        LETTER_N
    elif kind == simcity::city::POLICE:
        LETTER_O
    elif kind == simcity::city::FIRE:
        LETTER_F
    elif kind == simcity::city::PARK:
        LETTER_K
    else:
        0

# The letter each map object is labelled with, and zero where the object is
# read by its shape instead: the ground, the roads and the wires are what a
# player already tells apart by colour.
nomethod fn key_of(city: simcity::city::City, x: int, y: int) -> int:
    if simcity::city::road_at(city, x, y) != 0 or simcity::city::rail_at(city, x, y) != 0 or simcity::city::wire_at(city, x, y) != 0:
        0
    else:
        letter_of(simcity::city::zone_at(city, x, y))

# Each glyph is its five rows of five bits packed into one integer, the top
# row in the high bits and each row's leftmost pixel in its highest bit: the
# letter's pixel (COL, ROW) is set when the bit
# (LABEL - 1 - ROW) * LABEL + LABEL - 1 - COL of the glyph is set. One integer
# a letter is one value to compare, and the box's bounds are one guard.
nomethod fn glyph(letter: int) -> int:
    if letter == LETTER_R:
        32045713
    elif letter == LETTER_C:
        15254062
    elif letter == LETTER_I:
        14815374
    elif letter == LETTER_P:
        32045584
    elif letter == LETTER_N:
        18667121
    elif letter == LETTER_O:
        15255086
    elif letter == LETTER_F:
        33061392
    else:
        18444881

# WHETHER the glyph's pixel (COL, ROW) is drawn. The row and the column are
# bounded here and not only the bit they name: a letter is drawn in its box and
# a pixel outside the box sets nothing, or the letter at the edge of a tile
# would be read onto the tile beside it.
nomethod fn glyph_on(letter: int, row: int, col: int) -> bool:
    if row < 0 or row >= LABEL or col < 0 or col >= LABEL:
        false
    else:
        place = (LABEL - 1 - row) * LABEL + LABEL - 1 - col
        bit_and(glyph(letter).shift_right(place), 1) == 1

#
# Every colour here is made up for this game. The greens and greys of the
# ground, the blue of the roads, the yellow of the wires: the map reads by hue,
# so a developed tile, a plant and a bare tile are not the same on screen.
# The three networks are three different values of the same three numbers --
# a road asphalt, a rail wood-brown, a wire brass -- so the hue says which one
# it is before the shape does.
WATER_INK = 40 * 65536 + 86 * 256 + 146

GRASS_INK = 76 * 65536 + 126 * 256 + 70

TREES_INK = 44 * 65536 + 92 * 256 + 52

ROUGH_INK = 122 * 65536 + 114 * 256 + 82

# A road: asphalt, with the pale line the carriageway is marked with.
ROAD_INK = 66 * 65536 + 70 * 256 + 80

ROAD_LINE = 128 * 65536 + 132 * 256 + 142

# A rail: wood-brown, with its sleepers.
RAIL_INK = 108 * 65536 + 92 * 256 + 74

RAIL_TIE = 74 * 65536 + 62 * 256 + 52

# A power line: brass while it is dead, and bright yellow once it is live.
WIRE_INK = 138 * 65536 + 122 * 256 + 84

WIRE_LIVE = 236 * 65536 + 198 * 256 + 62

ZONE_RES_INK = 126 * 65536 + 190 * 256 + 116

ZONE_COM_INK = 126 * 65536 + 164 * 256 + 214

ZONE_IND_INK = 168 * 65536 + 168 * 256 + 190

ZONE_BARE = 200 * 65536 + 200 * 256 + 180

COAL_INK = 126 * 65536 + 104 * 256 + 92

NUCLEAR_INK = 206 * 65536 + 206 * 256 + 132

POLICE_INK = 96 * 65536 + 116 * 256 + 202

FIRE_INK = 202 * 65536 + 100 * 256 + 88

PARK_INK = 96 * 65536 + 186 * 256 + 96

# The tile under the pointer: a one-pixel frame in the colour of what a
# placement there would answer, so the player sees whether it will work before
# committing to it. The four inks are the same four the palette and the note
# line use.
CURSOR_OK = 120 * 65536 + 224 * 256 + 134

CURSOR_POOR = 244 * 65536 + 200 * 256 + 78

CURSOR_NO = 232 * 65536 + 96 * 256 + 96

CURSOR_LOOK = 244 * 65536 + 244 * 256 + 244

# The frame of a tile the view cannot show: no tool answers for ground that is
# not on the map, so it is the one answer with nothing behind it.
CURSOR_OFF = 132 * 65536 + 136 * 256 + 148

LABEL_INK = 24 * 65536 + 28 * 256 + 40

nomethod fn channel(v: int) -> int:
    if v < 0:
        0
    elif v > 255:
        255
    else:
        v

nomethod fn blue(ink: int) -> std::byte::Byte errors std::byte::AboveRange, std::byte::BelowRange:
    std::byte::from_int(channel(bit_and(ink, 255)))

nomethod fn flat(rows: List[List[std::byte::Byte]]) -> List[std::byte::Byte]:
    std::list::flat(rows)

nomethod fn zone_ink(kind: int, level: int) -> int:
    if level <= 0:
        ZONE_BARE
    elif kind == simcity::city::RES:
        ZONE_RES_INK
    elif kind == simcity::city::COM:
        ZONE_COM_INK
    else:
        ZONE_IND_INK

# A developed tile draws a bright core inside its tile, one texture-pixel row
# taller for every level it has: growth is visible as the core grows.
nomethod fn core_rows(city: simcity::city::City, x: int, y: int) -> int:
    level = simcity::city::level_at(city, x, y)
    if level <= 0:
        0
    elif level > TILE - 1:
        TILE - 1
    else:
        level

#
# `/` divides Float64 values only and Botlish has no integer division, so the
# two divisions a frame needs (a texture-pixel row into its map row, and a
# packed colour into its channels) are thirty-two restoring steps, bit by bit.
nomethod fn whole(value: Float64) -> int:
    if value < 0.0:
        0
    else:
        std::float64::truncate(value)

nomethod fn div_bits(a: int, b: int, rem: int, q: int, bit: int) -> int:
    if bit < 0:
        q
    else:
        here = rem.shift_left(1) + bit_and(a.shift_right(bit), 1)
        fits = here >= b
        rest = if fits:
            here - b
        else:
            here
        next_q = if fits:
            q.shift_left(1) + 1
        else:
            q.shift_left(1)
        div_bits(a, b, rest, next_q, bit - 1)

nomethod fn div(a: int, b: int) -> int:
    if b <= 0:
        0
    elif a < 0:
        -div(-a, b)
    else:
        div_bits(a, b, 0, 0, 31)

nomethod fn red(ink: int) -> std::byte::Byte errors std::byte::AboveRange, std::byte::BelowRange:
    std::byte::from_int(channel(div(ink, 65536)))

nomethod fn green(ink: int) -> std::byte::Byte errors std::byte::AboveRange, std::byte::BelowRange:
    std::byte::from_int(channel(bit_and(div(ink, 256), 255)))

nomethod fn pixel(ink: int) -> List[std::byte::Byte] errors std::byte::AboveRange, std::byte::BelowRange:
    [red(ink), green(ink), blue(ink), std::byte::from_int(255)]

# A colour with each channel halved: the faint line a block boundary is drawn
# with, so a thirty-two-pixel square of the map reads as a square.
nomethod fn dim(ink: int) -> int:
    div(ink, 65536).shift_right(1) * 65536 + div(bit_and(ink, 65280), 256).shift_right(1) * 256 + bit_and(ink, 255).shift_right(1)

# --- The ground -------------------------------------------------------------

nomethod fn terrain_ink(city: simcity::city::City, x: int, y: int) -> int:
    ground = simcity::city::terrain(city, x, y)
    if ground == simcity::city::WATER:
        WATER_INK
    elif ground == simcity::city::TREES:
        TREES_INK
    elif ground == simcity::city::ROUGH:
        ROUGH_INK
    else:
        GRASS_INK

# What stands on the tile, for a tile that holds no line.
nomethod fn ground(city: simcity::city::City, x: int, y: int) -> int:
    kind = simcity::city::zone_at(city, x, y)
    if kind == simcity::city::NONE:
        terrain_ink(city, x, y)
    elif kind == simcity::city::COAL:
        COAL_INK
    elif kind == simcity::city::NUCLEAR:
        NUCLEAR_INK
    elif kind == simcity::city::POLICE:
        POLICE_INK
    elif kind == simcity::city::FIRE:
        FIRE_INK
    elif kind == simcity::city::PARK:
        PARK_INK
    else:
        zone_ink(kind, simcity::city::level_at(city, x, y))

nomethod fn core_ink(city: simcity::city::City, x: int, y: int) -> int:
    kind = simcity::city::zone_at(city, x, y)
    if kind == simcity::city::RES:
        176 * 65536 + 232 * 256 + 164
    elif kind == simcity::city::COM:
        176 * 65536 + 208 * 256 + 240
    elif kind == simcity::city::IND:
        214 * 65536 + 214 * 256 + 230
    elif kind == simcity::city::COAL:
        168 * 65536 + 140 * 256 + 124
    elif kind == simcity::city::NUCLEAR:
        238 * 65536 + 238 * 256 + 168
    elif kind == simcity::city::POLICE:
        136 * 65536 + 156 * 256 + 236
    elif kind == simcity::city::FIRE:
        236 * 65536 + 140 * 256 + 126
    elif kind == simcity::city::PARK:
        140 * 65536 + 218 * 256 + 140
    else:
        ground(city, x, y)

# --- The three networks -----------------------------------------------------
#
# A line is drawn along its own direction rather than filling its tile, so a
# run of road is a road and not a grey bar. Which way it runs is read from the
# tiles beside it: a line that reaches both sides of a tile runs across it, one
# that reaches its top and bottom runs down it, and one that reaches nowhere is
# a tile of its own and is drawn as a dot.

# The middle two rows or columns of a tile, where a line's own ink goes.
nomethod fn stripe_across?(row: int) -> bool:
    row >= CROSS_AT and row < CROSS_AT + CROSS_WIDE

nomethod fn stripe_down?(col: int) -> bool:
    col >= CROSS_AT and col < CROSS_AT + CROSS_WIDE

# A road tile: asphalt, with a pale stripe where the carriageway is marked.
# HERE is the tile's own road value, already read by its caller.
nomethod fn road_ink(city: simcity::city::City, x: int, y: int, row: int, col: int) -> int:
    across = simcity::city::road_at(city, x - 1, y) != 0 or simcity::city::road_at(city, x + 1, y) != 0
    down = simcity::city::road_at(city, x, y - 1) != 0 or simcity::city::road_at(city, x, y + 1) != 0
    marked = if across:
        stripe_across?(row)
    elif down:
        stripe_down?(col)
    else:
        stripe_across?(row) and stripe_down?(col)
    if marked:
        ROAD_LINE
    else:
        ROAD_INK

# A rail tile: wood-brown, with a sleeper every two rows.
nomethod fn rail_ink(city: simcity::city::City, x: int, y: int, row: int, col: int) -> int:
    across = simcity::city::rail_at(city, x - 1, y) != 0 or simcity::city::rail_at(city, x + 1, y) != 0
    down = simcity::city::rail_at(city, x, y - 1) != 0 or simcity::city::rail_at(city, x, y + 1) != 0
    along = if across:
        stripe_across?(row)
    elif down:
        stripe_down?(col)
    else:
        stripe_across?(row) and stripe_down?(col)
    if along and col.mod(2) == 0:
        RAIL_TIE
    else:
        RAIL_INK

# A wire tile: a brass line while it is dead, and a bright one once power runs.
nomethod fn wire_run(city: simcity::city::City, x: int, y: int, row: int, col: int) -> int:
    across = simcity::city::wire_at(city, x - 1, y) != 0 or simcity::city::wire_at(city, x + 1, y) != 0
    down = simcity::city::wire_at(city, x, y - 1) != 0 or simcity::city::wire_at(city, x, y + 1) != 0
    along = if across:
        stripe_across?(row)
    elif down:
        stripe_down?(col)
    else:
        stripe_across?(row) and stripe_down?(col)
    if along:
        if simcity::city::powered_at(city, x, y) != 0:
            WIRE_LIVE
        else:
            WIRE_INK
    else:
        terrain_ink(city, x, y)

# The ink a wire crossing a road or a rail is drawn with: the wires' own ink,
# and its live colour once power runs along it. A crossing is read in
# `tile_ink`, which has the tile's road and rail values already.
nomethod fn wire_ink(city: simcity::city::City, x: int, y: int) -> int:
    if simcity::city::powered_at(city, x, y) != 0:
        WIRE_LIVE
    else:
        WIRE_INK

# Which way the wire runs through the crossing, so the stripe follows it: the
# four neighbours of a wire tile are where the line continues, and a neighbour
# either side means the wire crosses here in that direction.
nomethod fn wire_runs_across?(city: simcity::city::City, x: int, y: int) -> bool:
    left = simcity::city::wire_at(city, x - 1, y) != 0
    right = simcity::city::wire_at(city, x + 1, y) != 0
    left and right

nomethod fn wire_runs_down?(city: simcity::city::City, x: int, y: int) -> bool:
    up = simcity::city::wire_at(city, x, y - 1) != 0
    down = simcity::city::wire_at(city, x, y + 1) != 0
    up and down

# WHETHER this pixel of the tile is on the wire's stripe: two pixels either
# side of the tile's middle, running across or down. A stripe of two shows a
# line at this size without a cell's whole tile being wire.
nomethod fn on_wire(row: int, col: int, across: bool) -> bool:
    band = if across:
        stripe_across?(row)
    else:
        stripe_down?(col)
    band

# --- The block grid ---------------------------------------------------------
#
# A tile is eight pixels, which is too big to judge a distance by. A faint line
# across every fourth tile gives the map a scale the player can count in, and
# it is drawn on the tiles' own ink rather than over anything, so it never
# hides a letter.

# WHETHER this pixel is the block boundary: the last row of the bottom tile of
# a block, or the last column of its rightmost one. Only those two pixels of a
# tile can be one, and a frame asks this of every pixel, so the two tests that
# are nearly always false come first.
nomethod fn grid_line?(x: int, y: int, row: int, col: int) -> bool:
    if col != TILE - 1 and row != TILE - 1:
        false
    elif col == TILE - 1 and x.mod(BLOCK) == BLOCK - 1:
        true
    else:
        row == TILE - 1 and y.mod(BLOCK) == BLOCK - 1

# --- The tile ---------------------------------------------------------------
#
# One texture pixel of a tile: the ink of what stands on it, the block's faint
# line, the letter that says what the object is, and the one-pixel frame that
# marks the tile under the pointer.

# The ink of the tile at (X, Y), at its texture pixel (ROW, COL), with no
# letter, no core and no cursor on it. A road, a rail and a wire are each drawn
# along their own direction, so the first thing a tile is asked is which of
# the three it holds -- and the answer is read once, because a frame asks this
# question of every pixel of every tile on the screen.
nomethod fn tile_ink(city: simcity::city::City, x: int, y: int, row: int, col: int) -> int:
    road = simcity::city::road_at(city, x, y)
    rail = simcity::city::rail_at(city, x, y)
    wire = simcity::city::wire_at(city, x, y)
    ink = if wire != 0 and (road != 0 or rail != 0):
        stripe = on_wire(row, col, wire_runs_across?(city, x, y) or not wire_runs_down?(city, x, y))
        if stripe:
            wire_ink(city, x, y)
        elif road != 0:
            ROAD_INK
        else:
            RAIL_INK
    elif road != 0:
        road_ink(city, x, y, row, col)
    elif rail != 0:
        rail_ink(city, x, y, row, col)
    elif wire != 0:
        wire_run(city, x, y, row, col)
    else:
        ground(city, x, y)
    if grid_line?(x, y, row, col):
        dim(ink)
    else:
        ink

# What a placement of TOOL on the tile under the pointer would answer, as the
# colour its frame is drawn in: green for it fits, amber for the treasury, red
# for the ground, and white where there is nothing chosen to place. One exit
# per answer, so a reader follows one decision.
nomethod fn preview_ink(city: simcity::city::City, tool: Tool, x: int, y: int) -> int:
    if tool == Tool::None or tool == Tool::Inspect:
        CURSOR_LOOK
    else:
        outcome = simcity::actions::fits(city, tool, x, y)
        if outcome == simcity::actions::Placed::Built:
            CURSOR_OK
        elif outcome == simcity::actions::Placed::Poor:
            CURSOR_POOR
        elif outcome == simcity::actions::Placed::Blocked:
            CURSOR_NO
        else:
            CURSOR_OFF

# WHETHER (ROW, COL) is the tile's own edge: the one-pixel frame the cursor is
# drawn as. The interior is left alone, so the letter and the colour of the
# tile under the pointer are still readable while it is being placed.
nomethod fn edge_pixel?(row: int, col: int) -> bool:
    row == 0 or col == 0 or row == TILE - 1 or col == TILE - 1

nomethod fn shade(city: simcity::city::City, x: int, y: int, row: int, col: int, at: int, tool: Tool) -> List[std::byte::Byte] errors std::byte::AboveRange, std::byte::BelowRange:
    under = at == simcity::city::pack(x, y)
    if under and edge_pixel?(row, col) and tool != Tool::None:
        pixel(preview_ink(city, tool, x, y))
    else:
        ink = tile_ink(city, x, y, row, col)
        lit = if row > 0 and row <= core_rows(city, x, y):
            core_ink(city, x, y)
        else:
            ink
        letter = key_of(city, x, y)
        if letter > 0 and glyph_on(letter, row - LABEL_AT, col - LABEL_AT):
            pixel(LABEL_INK)
        else:
            pixel(lit)

# One texture-pixel row of the viewport: `row` is the pixel row within the
# tile, `ty` the map row it belongs to.
nomethod fn span(city: simcity::city::City, origin_x: int, ty: int, row: int, across: int, at: int, tool: Tool) -> List[std::byte::Byte] errors std::byte::AboveRange, std::byte::BelowRange:
    pixels = loop px from 0 to TILE * across:
        tile = div(px, TILE)
        shade(city, origin_x + tile, ty, row, px.mod(TILE), at, tool)
    flat(pixels)

# The whole viewport as one list of bytes, with the tile AT (or none) marked
# as the placement preview.
nomethod fn frame_with(city: simcity::city::City, origin_x: int, origin_y: int, across: int, down: int, at: int, tool: Tool) -> List[std::byte::Byte] errors std::byte::AboveRange, std::byte::BelowRange:
    rows = loop py from 0 to TILE * down:
        span(city, origin_x, origin_y + div(py, TILE), py.mod(TILE), across, at, tool)
    flat(rows)

# The viewport with the tile AT marked, for the tests: a tile is marked with
# the chosen tool's preview, and nothing at all is chosen by default.
nomethod fn frame(city: simcity::city::City, origin_x: int, origin_y: int, across: int, down: int, at: int) -> List[std::byte::Byte] errors std::byte::AboveRange, std::byte::BelowRange:
    frame_with(city, origin_x, origin_y, across, down, at, Tool::None)
