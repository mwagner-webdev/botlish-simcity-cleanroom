# simcity::render -- the city as pixels.
#
# The map is drawn into one RGBA byte list which the game's screen uploads as
# a texture: TILE texture pixels to a side for every map tile, so a whole
# viewport is one list of bytes and redrawing one tile is redrawing one tile.
# Eight texture pixels per tile is enough room for the single letter that says
# what the object is, which is the whole point of the size: a 3 by 3 zoning
# block has no room for a word, but it has room for R, C, I, P, N, O, F or K.
#
# The letters are a five by five bitmap font drawn here as pixel patterns:
# the game has no font to draw with inside a texture, and a letter made of
# pixels is the same weight of work as a letter drawn by a library.
#
# A frame is built with collecting loops, because Botlish has no list
# concatenation: each loop collects its own rows, and the loops are nested so
# that the outermost one collects whole texture-pixel rows of the viewport.
#
# A colour is a packed integer, red in the high byte and blue in the low,
# because a module-level binding may not construct a struct -- a constant in
# Botlish is a number or a string, never a value of its own making.

import std::byte

import std::float64

import std::list

import type simcity::city::Tool

import simcity::city

# Texture pixels per map tile.
TILE = 8

# The side of a label's box inside a tile, and where the box begins.
LABEL = 5

LABEL_AT = 1

# Where a crossing's stripe begins, and how wide it is: the middle two rows or
# columns of the tile, so the wire shows across the carriageway it crosses.
CROSS_AT = 3

CROSS_WIDE = 2

#
# A number per letter, so the glyph table is a list of lists rather than a
# switch over strings.
LETTER_R = 1

LETTER_C = 2

LETTER_I = 3

LETTER_P = 4

LETTER_N = 5

LETTER_O = 6

LETTER_F = 7

LETTER_K = 8

# The letter a zoning category or a building is labelled with, and zero for
# the ground: one exit per answer, so the reader follows one decision.
nomethod fn letter_of(kind: int) -> int:
    if kind == simcity::city::RES:
        LETTER_R
    elif kind == simcity::city::COM:
        LETTER_C
    elif kind == simcity::city::IND:
        LETTER_I
    elif kind == simcity::city::COAL:
        LETTER_P
    elif kind == simcity::city::NUCLEAR:
        LETTER_N
    elif kind == simcity::city::POLICE:
        LETTER_O
    elif kind == simcity::city::FIRE:
        LETTER_F
    elif kind == simcity::city::PARK:
        LETTER_K
    else:
        0

# The letter each map object is labelled with, and zero where the object is
# read by its shape instead: the ground, the roads and the wires are what a
# player already tells apart by colour.
nomethod fn key_of(city: simcity::city::City, x: int, y: int) -> int:
    if simcity::city::road_at(city, x, y) != 0 or simcity::city::rail_at(city, x, y) != 0 or simcity::city::wire_at(city, x, y) != 0:
        0
    else:
        letter_of(simcity::city::zone_at(city, x, y))

# Each glyph is its five rows of five bits packed into one integer, the top
# row in the high bits and each row's leftmost pixel in its highest bit: the
# letter's pixel (COL, ROW) is set when the bit
# (LABEL - 1 - ROW) * LABEL + LABEL - 1 - COL of the glyph is set. One integer
# a letter is one value to compare, and the box's bounds are one guard.
nomethod fn glyph(letter: int) -> int:
    if letter == LETTER_R:
        32045713
    elif letter == LETTER_C:
        15254062
    elif letter == LETTER_I:
        14815374
    elif letter == LETTER_P:
        32045584
    elif letter == LETTER_N:
        18667121
    elif letter == LETTER_O:
        15255086
    elif letter == LETTER_F:
        33061392
    else:
        18444881

# WHETHER the glyph's pixel (COL, ROW) is drawn. The row and the column are
# bounded here and not only the bit they name: a letter is drawn in its box and
# a pixel outside the box sets nothing, or the letter at the edge of a tile
# would be read onto the tile beside it.
nomethod fn glyph_on(letter: int, row: int, col: int) -> bool:
    if row < 0 or row >= LABEL or col < 0 or col >= LABEL:
        false
    else:
        place = (LABEL - 1 - row) * LABEL + LABEL - 1 - col
        bit_and(glyph(letter).shift_right(place), 1) == 1

#
# Every colour here is made up for this game. The greens and greys of the
# ground, the blue of the roads, the yellow of the wires: the map reads by hue,
# so a developed tile, a plant and a bare tile are not the same on screen.
WATER_INK = 38 * 65536 + 74 * 256 + 128

GRASS_INK = 72 * 65536 + 122 * 256 + 66

TREES_INK = 44 * 65536 + 90 * 256 + 48

ROUGH_INK = 120 * 65536 + 112 * 256 + 80

ROAD_INK = 84 * 65536 + 84 * 256 + 88

WIRE_INK = 96 * 65536 + 92 * 256 + 88

WIRE_LIVE = 232 * 65536 + 196 * 256 + 60

RAIL_INK = 110 * 65536 + 98 * 256 + 82

ZONE_RES_INK = 126 * 65536 + 190 * 256 + 116

ZONE_COM_INK = 126 * 65536 + 164 * 256 + 214

ZONE_IND_INK = 168 * 65536 + 168 * 256 + 190

ZONE_BARE = 200 * 65536 + 200 * 256 + 180

COAL_INK = 126 * 65536 + 104 * 256 + 92

NUCLEAR_INK = 206 * 65536 + 206 * 256 + 132

POLICE_INK = 96 * 65536 + 116 * 256 + 202

FIRE_INK = 202 * 65536 + 100 * 256 + 88

PARK_INK = 96 * 65536 + 186 * 256 + 96

CURSOR_INK = 244 * 65536 + 240 * 256 + 214

LABEL_INK = 24 * 65536 + 28 * 256 + 40

nomethod fn channel(v: int) -> int:
    if v < 0:
        0
    elif v > 255:
        255
    else:
        v

nomethod fn blue(ink: int) -> std::byte::Byte errors std::byte::AboveRange, std::byte::BelowRange:
    std::byte::from_int(channel(bit_and(ink, 255)))

nomethod fn flat(rows: List[List[std::byte::Byte]]) -> List[std::byte::Byte]:
    std::list::flat(rows)

nomethod fn zone_ink(kind: int, level: int) -> int:
    if level <= 0:
        ZONE_BARE
    elif kind == simcity::city::RES:
        ZONE_RES_INK
    elif kind == simcity::city::COM:
        ZONE_COM_INK
    else:
        ZONE_IND_INK

# A developed tile draws a bright core inside its tile, one texture-pixel row
# taller for every level it has: growth is visible as the core grows.
nomethod fn core_rows(city: simcity::city::City, x: int, y: int) -> int:
    level = simcity::city::level_at(city, x, y)
    if level <= 0:
        0
    elif level > TILE - 1:
        TILE - 1
    else:
        level

#
# `/` divides Float64 values only and Botlish has no integer division, so the
# two divisions a frame needs (a texture-pixel row into its map row, and a
# packed colour into its channels) are thirty-two restoring steps, bit by bit.
nomethod fn whole(value: Float64) -> int:
    if value < 0.0:
        0
    else:
        std::float64::truncate(value)

nomethod fn div_bits(a: int, b: int, rem: int, q: int, bit: int) -> int:
    if bit < 0:
        q
    else:
        here = rem.shift_left(1) + bit_and(a.shift_right(bit), 1)
        fits = here >= b
        rest = if fits:
            here - b
        else:
            here
        next_q = if fits:
            q.shift_left(1) + 1
        else:
            q.shift_left(1)
        div_bits(a, b, rest, next_q, bit - 1)

nomethod fn div(a: int, b: int) -> int:
    if b <= 0:
        0
    elif a < 0:
        -div(-a, b)
    else:
        div_bits(a, b, 0, 0, 31)

nomethod fn red(ink: int) -> std::byte::Byte errors std::byte::AboveRange, std::byte::BelowRange:
    std::byte::from_int(channel(div(ink, 65536)))

nomethod fn green(ink: int) -> std::byte::Byte errors std::byte::AboveRange, std::byte::BelowRange:
    std::byte::from_int(channel(bit_and(div(ink, 256), 255)))

nomethod fn pixel(ink: int) -> List[std::byte::Byte] errors std::byte::AboveRange, std::byte::BelowRange:
    [red(ink), green(ink), blue(ink), std::byte::from_int(255)]

# A colour with each channel halved: a tile that should be lit but is not.
nomethod fn dim(ink: int) -> int:
    div(ink, 65536) * 65536 + bit_and(div(ink, 2048), 60) * 256 + bit_and(div(ink, 8), 60)

nomethod fn terrain_ink(city: simcity::city::City, x: int, y: int) -> int:
    ground = simcity::city::terrain(city, x, y)
    if ground == simcity::city::WATER:
        WATER_INK
    elif ground == simcity::city::TREES:
        TREES_INK
    elif ground == simcity::city::ROUGH:
        ROUGH_INK
    else:
        GRASS_INK

# WHETHER a wire runs through this tile over a road or a rail, so the tile is a
# crossing rather than a plain line: power under a carriageway.
nomethod fn crossing?(city: simcity::city::City, x: int, y: int) -> bool:
    simcity::city::wire_at(city, x, y) != 0 and (simcity::city::road_at(city, x, y) != 0 or simcity::city::rail_at(city, x, y) != 0)

# The tile's own ink under a crossing's stripe: the carriageway's colour, so
# the map still reads by hue and the wire is the stripe laid over it. A
# crossing is only ever a wire over a road or a rail, so the branch that is
# left is the rail.
nomethod fn under_ink(city: simcity::city::City, x: int, y: int) -> int:
    if simcity::city::road_at(city, x, y) != 0:
        ROAD_INK
    else:
        RAIL_INK

# The ink a wire crossing a road or a rail is drawn with: the wires' own ink,
# and its live colour once power runs along it.
nomethod fn wire_ink(city: simcity::city::City, x: int, y: int) -> int:
    if simcity::city::powered_at(city, x, y) != 0:
        WIRE_LIVE
    else:
        WIRE_INK

# Which way the wire runs through the crossing, so the stripe follows it: the
# four neighbours of a wire tile are where the line continues, and a neighbour
# either side means the wire crosses here in that direction.
nomethod fn wire_runs_across?(city: simcity::city::City, x: int, y: int) -> bool:
    left = simcity::city::wire_at(city, x - 1, y) != 0
    right = simcity::city::wire_at(city, x + 1, y) != 0
    left and right

nomethod fn wire_runs_down?(city: simcity::city::City, x: int, y: int) -> bool:
    up = simcity::city::wire_at(city, x, y - 1) != 0
    down = simcity::city::wire_at(city, x, y + 1) != 0
    up and down

# WHETHER this pixel of the tile is on the wire's stripe: two pixels either
# side of the tile's middle, running across or down. A stripe of two shows a
# line at this size without a cell's whole tile being wire.
nomethod fn on_wire(row: int, col: int, across: bool) -> bool:
    band = if across:
        row >= CROSS_AT and row < CROSS_AT + CROSS_WIDE
    else:
        col >= CROSS_AT and col < CROSS_AT + CROSS_WIDE
    band

nomethod fn ground(city: simcity::city::City, x: int, y: int) -> int:
    kind = simcity::city::zone_at(city, x, y)
    if simcity::city::road_at(city, x, y) != 0:
        ROAD_INK
    elif simcity::city::rail_at(city, x, y) != 0:
        RAIL_INK
    elif simcity::city::wire_at(city, x, y) != 0:
        if simcity::city::powered_at(city, x, y) != 0:
            WIRE_LIVE
        else:
            WIRE_INK
    elif kind == simcity::city::NONE:
        terrain_ink(city, x, y)
    elif kind == simcity::city::COAL:
        COAL_INK
    elif kind == simcity::city::NUCLEAR:
        NUCLEAR_INK
    elif kind == simcity::city::POLICE:
        POLICE_INK
    elif kind == simcity::city::FIRE:
        FIRE_INK
    elif kind == simcity::city::PARK:
        PARK_INK
    else:
        zone_ink(kind, simcity::city::level_at(city, x, y))

nomethod fn core_ink(city: simcity::city::City, x: int, y: int) -> int:
    kind = simcity::city::zone_at(city, x, y)
    if kind == simcity::city::RES:
        176 * 65536 + 232 * 256 + 164
    elif kind == simcity::city::COM:
        176 * 65536 + 208 * 256 + 240
    elif kind == simcity::city::IND:
        214 * 65536 + 214 * 256 + 230
    elif kind == simcity::city::COAL:
        168 * 65536 + 140 * 256 + 124
    elif kind == simcity::city::NUCLEAR:
        238 * 65536 + 238 * 256 + 168
    elif kind == simcity::city::POLICE:
        136 * 65536 + 156 * 256 + 236
    elif kind == simcity::city::FIRE:
        236 * 65536 + 140 * 256 + 126
    elif kind == simcity::city::PARK:
        140 * 65536 + 218 * 256 + 140
    else:
        ground(city, x, y)
# --- The frame -------------------------------------------------------------
# One texture pixel of the tile (X, Y) at pixel (COL, ROW) of that tile.
nomethod fn shade(city: simcity::city::City, x: int, y: int, row: int, col: int, at: int) -> List[std::byte::Byte] errors std::byte::AboveRange, std::byte::BelowRange:
    if at == simcity::city::pack(x, y):
        pixel(CURSOR_INK)
    elif crossing?(city, x, y):
        # The wire over the carriageway: the road or rail fills the tile and
        # the wire is a stripe of its own ink along it, so a crossing reads as
        # both at once rather than as whichever the drawing reached first.
        stripe = on_wire(row, col, wire_runs_across?(city, x, y) or not wire_runs_down?(city, x, y))
        if stripe:
            pixel(wire_ink(city, x, y))
        else:
            pixel(under_ink(city, x, y))
    else:
        ink = ground(city, x, y)
        lit = if row > 0 and row <= core_rows(city, x, y):
            core_ink(city, x, y)
        else:
            ink
        letter = key_of(city, x, y)
        if letter > 0 and glyph_on(letter, row - LABEL_AT, col - LABEL_AT):
            pixel(LABEL_INK)
        else:
            pixel(lit)

# One texture-pixel row of the viewport: `row` is the pixel row within the
# tile, `ty` the map row it belongs to.
nomethod fn span(city: simcity::city::City, origin_x: int, ty: int, row: int, across: int, at: int) -> List[std::byte::Byte] errors std::byte::AboveRange, std::byte::BelowRange:
    pixels = loop px from 0 to TILE * across:
        tile = div(px, TILE)
        shade(city, origin_x + tile, ty, row, px.mod(TILE), at)
    flat(pixels)

# The whole viewport as one list of bytes, with the tile AT (or none) marked
# as the placement preview.
nomethod fn frame(city: simcity::city::City, origin_x: int, origin_y: int, across: int, down: int, at: int) -> List[std::byte::Byte] errors std::byte::AboveRange, std::byte::BelowRange:
    rows = loop py from 0 to TILE * down:
        span(city, origin_x, origin_y + div(py, TILE), py.mod(TILE), across, at)
    flat(rows)
