# simcity::words -- the figures of a city, as the labels on the screen read.

#

# Botlish has no formatting and no interpolation, so every figure is built as

# text here and nowhere else: a label is given one string, and the string is

# made by this module from the city the simulation owns.

import std::int

import std::str

import simcity::actions

import simcity::city

import simcity::sim

import type simcity::city::Tool

nomethod fn char(c: UnicodeChar) -> str:
    "".append_char(c)

nomethod fn dollars(n: int) -> str:
    char('$').concat(std::int::to_string(n))

nomethod fn month_name(month: int) -> str:
    if month == 0:
        "Jan"
    elif month == 1:
        "Feb"
    elif month == 2:
        "Mar"
    elif month == 3:
        "Apr"
    elif month == 4:
        "May"
    elif month == 5:
        "Jun"
    elif month == 6:
        "Jul"
    elif month == 7:
        "Aug"
    elif month == 8:
        "Sep"
    elif month == 9:
        "Oct"
    elif month == 10:
        "Nov"
    else:
        "Dec"

nomethod fn year_of(months: int) -> int:
    1900 + simcity::sim::months_years(months)

nomethod fn show_funds(city: simcity::city::City) -> str:
    "Funds ".concat(dollars(simcity::city::funds(city)))

nomethod fn show_people(city: simcity::city::City) -> str:
    "People ".concat(std::int::to_string(simcity::city::population(city)))

nomethod fn show_jobs(city: simcity::city::City) -> str:
    "Jobs ".concat(std::int::to_string(simcity::city::jobs_open(city)))

nomethod fn show_tax(city: simcity::city::City) -> str:
    "Tax ".concat(std::int::to_string(simcity::city::tax_rate(city))).append_char('%')

nomethod fn show_income(city: simcity::city::City) -> str:
    "Taxes ".concat(dollars(simcity::city::income_year(city))).concat(" a year")

nomethod fn show_upkeep(city: simcity::city::City) -> str:
    "Upkeep ".concat(dollars(simcity::city::upkeep_year(city))).concat(" a year")

nomethod fn show_balance(city: simcity::city::City) -> str:
    "Balance ".concat(dollars(simcity::city::balance_year(city))).concat(" a year")

nomethod fn clamp(v: int, lo: int, hi: int) -> int:
    if v < lo:
        lo
    elif v > hi:
        hi
    else:
        v

nomethod fn each(seen: int, made: int, text: str) -> str:
    if made >= 20:
        text
    elif seen > 0:
        each(seen - 1, made + 1, text.append_char('#'))
    else:
        each(seen - 1, made + 1, text.append_char('.'))

# The tool's name, for the label that says what the player has chosen.
nomethod fn show_tool(tool: Tool) -> str:
    if tool == Tool::Road:
        "Road"
    elif tool == Tool::Wire:
        "Power line"
    elif tool == Tool::Rail:
        "Rail"
    elif tool == Tool::Residential:
        "Residential zone"
    elif tool == Tool::Commercial:
        "Commercial zone"
    elif tool == Tool::Industrial:
        "Industrial zone"
    elif tool == Tool::Coal:
        "Coal plant"
    elif tool == Tool::Nuclear:
        "Nuclear plant"
    elif tool == Tool::Police:
        "Police post"
    elif tool == Tool::Fire:
        "Fire post"
    elif tool == Tool::Park:
        "Park"
    elif tool == Tool::Bulldoze:
        "Bulldozer"
    elif tool == Tool::Inspect:
        "Inspect"
    else:
        "Nothing chosen"

nomethod fn zone_name(kind: int) -> str:
    if kind == simcity::city::RES:
        "Homes"
    elif kind == simcity::city::COM:
        "Shops"
    elif kind == simcity::city::IND:
        "Industry"
    elif kind == simcity::city::COAL:
        "Coal plant"
    elif kind == simcity::city::NUCLEAR:
        "Nuclear plant"
    elif kind == simcity::city::POLICE:
        "Police post"
    elif kind == simcity::city::FIRE:
        "Fire post"
    else:
        "Park"

# Why a placement did not happen, for the line that tells the player. The
# refusal that needs its own words is the crossing the original forbids: the
# tile looks empty, so "not clear" would leave a player guessing.
nomethod fn show_refusal(city: simcity::city::City, tool: Tool, x: int, y: int, outcome: simcity::actions::Placed) -> str:
    if outcome == simcity::actions::Placed::Blocked and simcity::city::line_tool?(tool) and not simcity::city::line_fits?(city, tool, x, y):
        if tool == Tool::Rail:
            "A rail may not cross a road."
        else:
            "A rail is already on that tile."
    elif outcome == simcity::actions::Placed::Poor:
        "Not enough funds for that."
    elif outcome == simcity::actions::Placed::Blocked:
        "The ground is not clear there."
    elif outcome == simcity::actions::Placed::Outside:
        "That is off the edge of the map."
    else:
        "Built."

nomethod fn show_cost(tool: Tool) -> str:
    char('$').concat(std::int::to_string(simcity::city::cost_of(tool)))

# What the tile under the cursor holds, for the inspector line: what stands on
# it, and the four conditions that decide what becomes of it.
nomethod fn show_tile(city: simcity::city::City, x: int, y: int) -> str:
    ground = simcity::city::terrain(city, x, y)
    kind = simcity::city::zone_at(city, x, y)
    where = "at ".append_char(' ').concat(std::int::to_string(x)).append_char(',').append_char(' ').concat(std::int::to_string(y))
    what = if simcity::city::road_at(city, x, y) != 0:
        "Road"
    elif simcity::city::rail_at(city, x, y) != 0:
        "Rail"
    elif simcity::city::wire_at(city, x, y) != 0:
        if simcity::city::powered_at(city, x, y) != 0:
            "Live power line"
        else:
            "Dead power line"
    elif kind != simcity::city::NONE:
        zone_name(kind)
    elif ground == simcity::city::WATER:
        "Water"
    elif ground == simcity::city::TREES:
        "Trees"
    elif ground == simcity::city::ROUGH:
        "Rough ground"
    else:
        "Bare land"
    level = simcity::city::level_at(city, x, y)
    grown = if kind != simcity::city::NONE and level > 0:
        ", level ".concat(std::int::to_string(level))
    else:
        ""
    powered = if simcity::city::powered_at(city, x, y) != 0:
        "on"
    else:
        "off"
    served = if simcity::city::access_at(city, x, y) != 0:
        "on"
    else:
        "off"
    smoke = simcity::city::pollution_at(city, x, y)
    crime = simcity::city::crime_at(city, x, y)
    worth = simcity::city::value_at(city, x, y)
    what.concat(grown).append_char(' ').concat(where).concat(", power ").concat(powered).concat(", road ").concat(served).concat(", smoke ").concat(std::int::to_string(smoke)).concat(", crime ").concat(std::int::to_string(crime)).concat(", worth ").concat(std::int::to_string(worth))

# The RCI bar's figure for one zoning category, as a bar of hash marks.
nomethod fn show_demand(city: simcity::city::City, slot: int) -> str:
    name = if slot == 0:
        char('R')
    elif slot == 1:
        char('C')
    else:
        char('I')
    want = simcity::city::want(city, slot)
    filled = if want >= 0:
        want
    else:
        -want
    name.append_char(' ').concat(each(filled, 0, ""))

nomethod fn show_date(city: simcity::city::City) -> str:
    month_name(simcity::city::month(city)).append_char(' ').concat(std::int::to_string(year_of(simcity::city::ticks(city))))
