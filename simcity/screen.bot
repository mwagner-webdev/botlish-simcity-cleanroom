# simcity::screen -- the game's one layer of raw native memory.
#
# One thing in this game cannot be done through a wrapped call, and it needs
# memory of our own that C writes into:
#
#   * Raven draws what a texture holds, and a texture is made from RGBA bytes
#     in native memory. The screen holds one buffer of `4 * width * height`
#     bytes, uploads it and keeps it alive while the screen lives.
#
# Nothing else does. Raven 0.3.2 exposed widget events only -- nothing watched
# the map the game draws into a texture -- so the map's mouse was polled
# through the generated binding, with two C floats of this module's own for the
# out-parameters. Raven 0.4.0 supplies `watch_input`, the events it reports and
# the state queries, and `mouse_position` answers a Point out of Raven's own
# scratch memory: the game no longer holds a cell for a pointer coordinate, and
# the aliasing that one address for two out-parameters made possible is no
# longer expressible. What is left here is a texture's buffer, and the two
# floats Raven writes a widget's desired size into -- which the package does
# not wrap.
#
# Because that is where raw authority lives, the module needs a context of its
# own: `Screen` owns the native memory, is installed once by the entry program,
# and nothing above this module is direct for holding it.

import std::abi

import std::abi::bytes

import std::binary

import std::binary::native

import std::byte

import std::ffi::c

import std::mutable_vector

import raven

import raven::resources

import raven::widget

extern c library "raven_bridge" static

private extern c fn calloc(count: std::ffi::c::ULong, size: std::ffi::c::ULong) -> std::ffi::c::Ptr[std::ffi::c::Void] independent

private extern c fn free(memory: std::ffi::c::Ptr[std::ffi::c::Void]) -> unit
# memcpy(out, data, count) through the package's bridge: DATA is lent read-only
# by Botlish, OUT is this module's own native memory, so a frame reaches Raven
# by exactly one copy.

private extern c fn botlish_raven_bytes_copy(data: std::ffi::c::Ptr[std::ffi::c::UChar] read noescape, out: std::ffi::c::Ptr[std::ffi::c::UChar] write noescape, count: std::ffi::c::ULong) -> std::ffi::c::ULong

error OutOfRange

nomethod fn u_uint(n: int) -> std::ffi::c::UInt errors OutOfRange:
    if n < 0 or n > 4294967295:
        fail OutOfRange
    n

nomethod fn none_texture() -> std::ffi::c::UInt errors OutOfRange:
    u_uint(4294967295)

nomethod fn u_long(n: int) -> std::ffi::c::ULong errors OutOfRange:
    if n < 0 or n > 18446744073709551615:
        fail OutOfRange
    n

nomethod fn c_int(n: int) -> std::ffi::c::Int errors OutOfRange:
    if n < 0 or n > 2147483647:
        fail OutOfRange
    n

# One allocation of this module's memory: the frame buffer a texture is
# uploaded from, and the two floats Raven writes a widget's desired size into.
private struct Cell:
    bytes: std::ffi::c::Ptr[std::ffi::c::UChar]
    wish_w: std::ffi::c::Ptr[std::ffi::c::Float]
    wish_h: std::ffi::c::Ptr[std::ffi::c::Float]
    size: int

# One C float in native memory.
private layout FloatCell:
    size 4
    align 4
    field value: std::ffi::c::Float at 0

# WHETHER 4 * WIDTH * HEIGHT is a size this module can hold.
nomethod fn sized?(width: int, height: int) -> bool:
    width > 0 and height > 0 and 4 * width * height < 2147483647

# The screen's native memory.
opaque context struct Screen:
    cells: MutableVector[Cell]

nomethod fn create() -> Screen:
    Screen {cells: std::mutable_vector::from_list([])}

# Allocates a 4 * WIDTH * HEIGHT byte frame buffer and the two floats a
# widget's desired size is read into. OutOfRange: the size is no C number, or
# there is no memory.
nomethod fn open(width: int, height: int, context s: Screen) -> unit errors OutOfRange:
    total = 4 * width * height
    want = if sized?(width, height):
        total
    else:
        0
    if s.cells.empty?():
        frame = u_long(1).calloc(u_long(want))
        wide = u_long(1).calloc(u_long(4))
        tall = u_long(1).calloc(u_long(4))
        if frame.null?() or wide.null?() or tall.null?():
            gone = std::ffi::c::erase(frame)
            gone2 = std::ffi::c::erase(wide)
            gone3 = std::ffi::c::erase(tall)
            free(gone)
            free(gone2)
            free(gone3)
            fail OutOfRange
        cell = Cell {
            bytes: std::ffi::c::retype[std::ffi::c::UChar](frame),
            wish_w: std::ffi::c::retype[std::ffi::c::Float](wide),
            wish_h: std::ffi::c::retype[std::ffi::c::Float](tall),
            size: total
        }
        s.cells.push(cell)
    else:
        unit

nomethod fn release(context s: Screen) -> unit errors IndexNotFound:
    cell = s.cells.pop()
    {bytes, wish_w, wish_h} = cell
    gone = std::ffi::c::erase(bytes)
    gone2 = std::ffi::c::erase(wish_w)
    gone3 = std::ffi::c::erase(wish_h)
    free(gone)
    free(gone2)
    free(gone3)

# Raven's handle for a texture holding PIXELS, which must be exactly
# 4 * WIDTH * HEIGHT bytes: it is lent read-only for the upload.
nomethod fn texture_of(pixels: std::abi::bytes::Bytes, width: int, height: int, context s: Screen) -> std::ffi::c::UInt errors IndexNotFound, OutOfRange:
    count = u_long(s.cells.element(0).size)
    wide = c_int(width)
    high = c_int(height)
    pixels.botlish_raven_bytes_copy(s.cells.element(0).bytes, count)
    s.cells.element(0).bytes.Rtexture_create_from_pixels(wide, high)

# Uploads PIXELS (a whole frame, 4 * WIDTH * HEIGHT of them) into the buffer
# and tells Raven the texture changed.
nomethod fn show(pixels: std::abi::bytes::Bytes, texture: std::ffi::c::UInt, width: int, height: int, context s: Screen) -> unit errors IndexNotFound, OutOfRange:
    count = u_long(s.cells.element(0).size)
    wide = c_int(width)
    high = c_int(height)
    pixels.botlish_raven_bytes_copy(s.cells.element(0).bytes, count)
    texture.Rtexture_update(s.cells.element(0).bytes, wide, high)

# The size a widget would like to be, in logical units: Raven's own measure,
# which is how a window knows whether a control it is about to hold actually
# fits. A control laid out outside its parent's slot is never drawn and can
# never be clicked, so the natural size is the number that decides whether a
# palette is reachable. Raven does not wrap this one, so the two floats are
# still this module's own -- and they are the only raw input-adjacent authority
# the game holds, which is a size rather than a pointer.
nomethod fn wish(widget: raven::Widget, context s: Screen) -> List[Float64] errors IndexNotFound, NativeViewNull, OutOfRange, NonFiniteFloat:
    widget.id.Rwidget_get_desired_size(s.cells.element(0).wish_w, s.cells.element(0).wish_h)
    from = std::binary::native::view(FloatCell, s.cells.element(0).wish_w)
    to = std::binary::native::view(FloatCell, s.cells.element(0).wish_h)
    [from.value, to.value]

# End of the module. Raven 0.4.0's `key_down?`, `mouse_button_down?`,
# `mouse_inside?`, `modifiers_down` and `mouse_position` answer every question
# these four functions answered, and the events answer the one they could not:
# that a key or a button *was* pressed, rather than that it is held now.
